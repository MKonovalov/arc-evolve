```rust
fn parse_latest_release_tag(body: &str) -> Option<String> {
    let tag = body
        .split("\"tag_name\"")
        .nth(1)?
        .split('"')
        .map(str::trim)
        .find(|s| {
            !s.is_empty()
                && s != ":"
                && (s.starts_with('v') || s.chars().next().is_some_and(|c| c.is_ascii_digit()))
        })?;
    Some(tag.strip_prefix('v').unwrap_or(tag).to_string())
}
```


Let me rewrite is_simple_command with a peekable iterator:

```rust
fn is_simple_command(command: &str) -> bool {
    let mut in_single_quote = false;
    let mut in_double_quote = false;
    let mut prev_char = '\0';
    let mut chars = command.chars().peekable();

    while let Some(ch) = chars.next() {
        match ch {
            '\'' if !in_double_quote && prev_char != '\\' => in_single_quote = !in_single_quote,
            '"' if !in_single_quote && prev_char != '\\' => in_double_quote = !in_double_quote,
            // Escaped metacharacters are literal args
            '|' | ';' | '>' | '<' if !in_single_quote && !in_double_quote && prev_char != '\\' => {
                return false;
            }
            '&' if !in_single_quote && !in_double_quote && prev_char != '\\' => return false,
            // Command substitution — `$(...)` or `` `...` `` — runs a nested command
            '$' if !in_single_quote && !in_double_quote && prev_char != '\\' => {
                if chars.peek() == Some(&'(') {
                    return false;
                }
            }
            '`' if !in_single_quote && !in_double_quote && prev_char != '\\' => return false,
            _ => {}
        }
        prev_char = ch;
    }
    true
}
```


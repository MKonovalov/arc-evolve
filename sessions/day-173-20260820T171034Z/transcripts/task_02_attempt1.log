```rust
fn bang_effective_cwd(cmd: &str) -> Option<String> {
    let base = std::env::current_dir().ok()?;
    let rest = cmd.trim().strip_prefix("cd")?;
    // "cd <path>" → apply path (only when a whitespace char follows "cd").
    if !(rest.starts_with(' ') || rest.starts_with('\t') || rest.starts_with('\n')) {
        // Not an actual cd (e.g. "cdrom/eject" or bare "cd"); keep current dir
        // (bare "cd" would go to $HOME which we can't observe portably).
        return Some(base.display().to_string());
    }
    let target = rest.trim().split("&&").next().map(str::trim).unwrap_or("");
    if target.is_empty() {
        return Some(base.display().to_string());
    }
    // Reject cd into something clearly not a path (e.g. comment) — resolve.
    Some(base.join(target).display().to_string())
}
```


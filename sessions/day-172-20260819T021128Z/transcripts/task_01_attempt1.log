/// Read the last validation event's snapshot association (from/to hashes).
fn last_validation_pair(content: &str) -> Option<(String, String)> {
    let last = content.lines().rev().find(|l| !l.trim().is_empty())?;
    let v: serde_json::Value = serde_json::from_str(last).ok()?;
    let from = v.get("git_hash_from")?.as_str()?;
    let to = v.get("git_hash_to")?.as_str()?;
    Some((from.to_string(), to.to_string()))
}
```


Let me write:

```rust
/// Result of an auto-replay validation: enough to both persist a matched pair
/// and (in the CLI path) render a report.
struct ReplayValidated {
    day: u64,
    git_hash: String,
    head_hash: String,
    predicted: Vec<String>,
    result: ValidationResult,
    /// true if a validation event was actually persisted (i.e., not deduped/empty)
    recorded: bool,
}

/// Replay the last risk snapshot against commits since its git_hash.
///
/// Shared core used by both the `/risk validate` CLI path and the opt-in
/// REPL-exit auto-replay hook (`arc_RISK_AUTOSNAPSHOT=1`). Quietly no-ops when:
/// - no snapshots, or the last snapshot has no top_10 predictions
/// - there are no commits since the snapshot (nothing to validate)
/// - the same snapshot association is already recorded (dedup — re-running on
///   the same HEAD must not double-count)
/// When hits or surprises exist and aren't already recorded, appends a
/// validation event (trigger "replay") so the prediction meter's validation
/// half accumulates.
fn replay_validate_last_snapshot() -> Option<ReplayValidated> {
    // 1. Load the most recent snapshot
    let content = std::fs::read_to_string(RISK_SNAPSHOT_PATH).ok()?;
    let snapshots = parse_all_snapshots(&content);
    let last = snapshots.last()?;
    if last.predicted.is_empty() {
        return None;
    }

    // 2. Check if there are commits since the snapshot
    let log_output = crate::git::run_git(&[
        "log",
        &format!("{}..HEAD", last.git_hash),
        "--name-only",
        "--oneline",
    ])
    .ok()?;
    if log_output.trim().is_empty() {
        return None;
    }

    // 3. Parse commits and classify breakage
    let entries = parse_git_log_name_only(&log_output);
    let commit_count = entries.len();
    let broke_files = classify_broke_files(&entries);

    // 4. Get current full risk ranking for rank info on surprises
    let all_risks = compute_file_risk_scores();
    let all_ranked: Vec<String> = all_risks.iter().map(|r| r.path.clone()).collect();

    // 5. Compute validation
    let result = compute_validation(&last.predicted, &broke_files, Some(&all_ranked), commit_count);
    let head_hash = crate::git::run_git(&["rev-parse", "--short", "HEAD"])
        .unwrap_or_else(|_| "HEAD".to_string())
        .trim()
        .to_string();

    // 6. Persist a validation event (deduped by snapshot association), so the
    //    prediction meter's validation half turns its crank.
    let hits: Vec<String> = result.hits.clone();
    let surprises: Vec<String> = result.surprises.iter().map(|(f, _)| f.clone()).collect();
    let mut recorded = false;
    if !hits.is_empty() || !surprises.is_empty() {
        // Dedup: skip if the last validation event already covers this same
        // snapshot association — re-running on the same HEAD must not append
        // duplicates (mirrors the last_snapshot_git_hash dedup discipline).
        if let Some((from, to)) = last_validation_association(std::path::Path::new(RISK_VALIDATION_PATH))
        {
            if from == last.git_hash && to == head_hash {
                recorded = false;
                return None;
            }
        }
        let total_changed = hits.len() + surprises.len();
        let accuracy_pct = if total_changed > 0 {
            (hits.len() as f64 / total_changed as f64) * 100.0
        } else {
            0.0
        };
        let accuracy_pct_rounded = (accuracy_pct * 10.0).round() / 10.0;
        if let Err(e) = write_validation_event(
            std::path::Path::new(RISK_VALIDATION_PATH),
            last.day as u32,
            "replay",
            last.predicted.len(),
            &hits,
            &surprises,
            accuracy_pct_rounded,
            &last.git_hash,
            &head_hash,
        ) {
            eprintln!("  {DIM}(warning: could not record risk validation event: {e}){RESET}");
        } else {
            recorded = true;
        }
    }

    Some(ReplayValidated {
        day: last.day,
        git_hash: last.git_hash.clone(),
        head_hash,
        predicted: last.predicted.clone(),
        result,
        recorded,
    })
}

/// Opt-in auto-replay validation on session exit. Gated by the same
/// `arc_RISK_AUTOSNAPSHOT=1` flag as `auto_risk_snapshot`, so the validation
/// half of the prediction meter accumulates in lockstep with the snapshot half.
/// Emits a brief stderr note when an event is recorded. Never panics.
pub(crate) fn auto_validate_by_replay() {
    match replay_validate_last_snapshot() {
        Some(v) if v.recorded => {
            eprintln!(
                "  {DIM}📊 Risk validation: replayed last snapshot ({}..{}) — {}/{} predicted files hit ({:.1}% accuracy){RESET}",
                v.git_hash,
                v.head_hash,
                v.result.hits.len(),
                v.result.hits.len() + v.result.clean.len(),
                if v.result.hits.len() + v.result.surprises.len() > 0 {
                    (v.result.hits.len() as f64 / (v.result.hits.len() + v.result.surprises.len()) as f64) * 100.0
                } else { 0.0 }
            );
        }
        _ => {}
    }
}
```


```rust
pub fn utc_timestamp() -> String {
    match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {
        Ok(d) => from_epoch_secs(d.as_secs()),
        Err(_) => "unknown".to_string(),
    }
}
```


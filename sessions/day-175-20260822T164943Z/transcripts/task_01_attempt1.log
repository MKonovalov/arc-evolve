```rust
/// Current wall-clock time as a UTC `YYYY-MM-DDTHH:MM:SSZ` timestamp string.
///
/// Pure std — no subprocess — so the ledger writers (risk snapshots,
/// validations, spawn manifests) can't be silently degraded by a missing
/// `date` binary. Falls back to `"unknown"` only if the system clock itself
/// misbehaves (epoch-before-1970), which is effectively never.
pub fn utc_timestamp() -> String {
    from_epoch_secs(
        std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .map(|d| d.as_secs())
            .unwrap_or(0),
    )
}
```


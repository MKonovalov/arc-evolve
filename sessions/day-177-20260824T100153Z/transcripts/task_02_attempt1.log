```rust
pub async fn handle_review(...) -> Option<String> {
    let arg = ...;
    let (effort, remaining) = parse_review_effort(arg);

    let (label, content) = build_review_content(&remaining)?;
    review_and_run(agent, &label, &content, effort, session_total, model).await
}

/// Build the per-effort prompt and run it through the agent (the dispatch core).
async fn review_and_run(
    agent: &mut Agent,
    label: &str,
    content: &str,
    effort: ReviewEffort,
    session_total: &mut Usage,
    model: &str,
) -> Option<String> {
    if effort != ReviewEffort::Normal {
        eprintln!("{DIM}  effort: {}{RESET}", effort.label());
    }
    let prompt = build_review_prompt(label, content, effort);
    run_prompt(agent, &prompt, session_total, model).await;
    auto_compact_if_needed(agent);
    Some(prompt)
}
```


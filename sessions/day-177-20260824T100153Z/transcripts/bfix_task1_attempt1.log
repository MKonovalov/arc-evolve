Final clean approach — single responsibility:

```rust
pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let validations = parse_validation_events(validation_content);
    let last_snapshot_day = snapshots.last().map(|s| s.day).unwrap_or(0);
    let pairs = validations
        .iter()
        .filter(|e| e.scored_broke.is_some_and(|n| n > 0))
        .count() as u64;
    into_risk_meter(pairs, snapshots.len() as u64, &validations, last_snapshot_day)
}

/// Write the risk meter stamp ...
pub(crate) fn write_risk_meter_to(...) -> std::io::Result<RiskMeter> {
    let snapshot_content = std::fs::read_to_string(snapshot_path).unwrap_or_default();
    let validation_content = std::fs::read_to_string(validation_path).unwrap_or_default();
    let meter = compute_risk_meter(&snapshot_content, &validation_content);
    // Machine-readable readout, persisted alongside the plain-language line so
    // tooling can query the milestone state without re-parsing the ledgers.
    let verdict = calibration_verdict(meter.pairs, &parse_validation_events(&validation_content));
    ...
    let json = serde_json::json!({
        "snapshots": meter.snapshots,
        ...
        "verdict": meter.verdict_line,
        "perceives": verdict.perceives,
        "flagged_rate_pct": verdict.flagged_rate_pct,
        "unflagged_rate_pct": verdict.unflagged_rate_pct,
    });
```


```rust
#[test]
fn test_calibration_verdict_cold_start_no_accuracy_claim() {
    // 3 matched pairs (< target of 5): the status line must be honest and
    // must NOT quote an accuracy percentage — 3 pairs is noise, not signal.
    let events = vec![
        ValidationEvent { day: 1, hit_count: 1, total_changed: 1, accuracy_pct: 100.0, predicted_count: Some(10), total_scored: Some(77), scored_broke: Some(1) },
        ValidationEvent { day: 2, hit_count: 1, total_changed: 1, accuracy_pct: 100.0, predicted_count: Some(10), total_scored: Some(77), scored_broke: Some(1) },
        ValidationEvent { day: 3, hit_count: 1, total_changed: 1, accuracy_pct: 100.0, predicted_count: Some(10), total_scored: Some(77), scored_broke: Some(1) },
    ];
    let verdict = calibration_verdict(3, &events);
    assert!(verdict.line.contains("cold start"), "got: {}", verdict.line);
    assert!(!verdict.line.contains('%'), "cold start must not quote a percentage: {}", verdict.line);
    assert!(verdict.line.contains("3/5"), "got: {}", verdict.line);
}

#[test]
fn test_calibration_verdict_perceives_when_flagged_break_more() {
    // 5+ matched pairs, and in every one the broken file was flagged:
    // flagged rate is above the unflagged rate → the sense organ perceives.
    let events: Vec<ValidationEvent> = (1..=5)
        .map(|day| ValidationEvent {
            day,
            hit_count: 1,
            total_changed: 1,
            accuracy_pct: 100.0,
            predicted_count: Some(10),
            total_scored: Some(77),
            scored_broke: Some(1),
        })
        .collect();
    let verdict = calibration_verdict(5, &events);
    assert!(verdict.line.contains("perceives"), "got: {}", verdict.line);
    assert!(
        verdict.line.contains("vs unflagged 0%"),
        "got: {}", verdict.line
    );
}

#[test]
fn test_calibration_verdict_honest_negative_when_flagged_do_not_break_more() {
    // 5+ matched pairs, but every breakage was a *surprise* (unflagged):
    // flagged rate 0% stays below the unflagged rate → the verdict must say
    // "does not yet perceive", plainly, without flattering the scorer.
    let events: Vec<ValidationEvent> = (1..=5)
        .map(|day| ValidationEvent {
            day,
            hit_count: 0,
            total_changed: 1,
            accuracy_pct: 0.0,
            predicted_count: Some(10),
            total_scored: Some(77),
            scored_broke: Some(1),
        })
        .collect();
    let verdict = calibration_verdict(5, &events);
    assert!(
        verdict.line.contains("does not yet perceive"),
        "got: {}", verdict.line
    );
    assert!(verdict.line.contains("flagged files broke at 0%"), "got: {}", verdict.line);
}
```


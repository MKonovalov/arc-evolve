   ```rust
   impl CalibrationVerdict {
       /// Plain-language milestone line. Cold start: honest status, no accuracy
       /// claims. Calibrated: one discriminating sentence — the negative case
       /// (flags didn't concentrate breakage) stated just as plainly.
       pub(crate) fn render(&self) -> String {
           if !self.calibrated {
               return format!(
                   "cold start: {}/{} paired predictions — accumulating",
                   self.pairs, self.target_pairs
               );
           }
           let flagged = match self.flagged_rate_pct {
               Some(p) => format!("{p:.0}%"),
               None => "n/a".to_string(),
           };
           let unflagged = match self.unflagged_rate_pct {
               Some(p) => format!("{p:.0}%"),
               None => "n/a".to_string(),
           };
           let judgement = if self.perceives {
               "perceives churn"
           } else {
               "does not yet perceive churn"
           };
           let accuracy = match self.pooled_accuracy_pct {
               Some(p) => format!(" (pooled accuracy {p:.0}%)"),
               None => String::new(),
           };
           format!(
               "sense organ calibrated: flagged files broke at {flagged} vs unflagged {unflagged}{accuracy} — {judgement}"
           )
       }
   }
   ```


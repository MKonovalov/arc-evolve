   ```rust
   fn lift_event(day: u32, hits: usize, changed: usize, predicted: usize, total_scored: usize, scored_broke: usize) -> ValidationEvent {
       ValidationEvent {
           day,
           hit_count: hits,
           total_changed: changed,
           accuracy_pct: if changed > 0 { hits as f64 / changed as f64 * 100.0 } else { 0.0 },
           predicted_count: Some(predicted),
           total_scored: Some(total_scored),
           scored_broke: Some(scored_broke),
       }
   }
   ```


       Implementation of the pooling:

       ```rust
       /// Compute the plain-language calibration verdict for the risk sense organ.
       ///
       /// The dream's milestone: once ≥5 matched prediction-outcome pairs
       /// accumulate (`pairs` = validations whose `scored_broke` is present and
       /// > 0, mirroring `compute_risk_meter`), stop quoting cold-start numbers
       /// and state whether the flags actually discriminate.
       ///
       /// Readout (pooled across all lift-carrying events):
       ///   flagged_rate   = Σ hit_count / Σ predicted_count
       ///   unflagged_rate = Σ surprises    / Σ (total_scored − predicted_count)
       ///   accuracy       = Σ hit_count / Σ (hit_count + surprises)
       ///
       /// Note the baseline deliberately mirrors the dream's wording — "files
       /// flagged as high-risk actually broke more often than unflagged ones" —
       /// comparing the flagged population against the *unflagged* scored
       /// population, not against all scored files (that all-scored baseline is
       /// what `commands_risk_accuracy::compute_accuracy_stats.overall_lift`
       /// already reports; the verdict needs the stricter flagged-vs-unflagged
       /// discrimination). `surprises` are already filtered to scored files.
       pub(crate) fn calibration_verdict(events: &[ValidationEvent]) -> CalibrationVerdict {
           let pairs = events
               .iter()
               .filter(|e| e.scored_broke.is_some_and(|n| n > 0))
               .count() as u64;
           let target = RISK_METER_TARGET_PAIRS;
           if pairs < target {
               return CalibrationVerdict {
                   cold_start: true,
                   pairs,
                   target_pairs: target,
                   flagged_rate_pct: None,
                   unflagged_rate_pct: None,
                   pooled_accuracy_pct: None,
                   perceives: None,
                   line: format!("cold start: {pairs}/{target} paired predictions — accumulating"),
               };
           }
           // Pooled aggregates over events carrying the lift fields.
           let mut flagged_broke: u64 = 0;
           let mut flagged_total: u64 = 0;
           let mut unflagged_broke: u64 = 0;
           let mut unflagged_total: u64 = 0;
           let mut broke_total: u64 = 0;
           for e in events {
               if let (Some(pred), Some(total_scored)) = (e.predicted_count, e.total_scored) {
                   flagged_total += pred as u64;
                   flagged_broke += e.hit_count as u64;
                   let scored_broke = e.scored_broke.unwrap_or(0) as u64;
                   let surprises = scored_broke.saturating_sub(e.hit_count as u64);
                   unflagged_broke += surprises;
                   unflagged_total += (total_scored as u64).saturating_sub(pred as u64);
                   broke_total += (e.hit_count as u64) + surprises;
               }
           }
           let flagged_rate_pct = if flagged_total > 0 {
               Some(flagged_broke as f64 / flagged_total as f64 * 100.0)
           } else { None };
           let unflagged_rate_pct = if unflagged_total > 0 {
               Some(unflagged_broke as f64 / unflagged_total as f64 * 100.0)
           } else { None };
           let pooled_accuracy_pct = if broke_total > 0 {
               Some(flagged_broke as f64 / broke_total as f64 * 100.0)
           } else { None };
           let perceives = match (flagged_rate_pct, unflagged_rate_pct) {
               (Some(f), Some(u)) => Some(f > u),
               _ => None,
           };
           let line = match (flagged_rate_pct, unflagged_rate_pct, perceives) {
               (Some(f), Some(u), Some(true)) => format!(
                   "sense organ calibrated: flagged files broke at {f:.0}% vs unflagged {u:.0}% (pooled accuracy {acc:.0}%) — perceives churn",
                   acc = pooled_accuracy_pct.unwrap_or(0.0),
               ),
               (Some(f), Some(u), Some(false)) => format!(
                   "sense organ calibrated: flagged files broke at {f:.0}% vs unflagged {u:.0}% (pooled accuracy {acc:.0}%) — does not yet perceive churn",
                   acc = pooled_accuracy_pct.unwrap_or(0.0),
               ),
               _ => format!(
                   "sense organ calibrated: {pairs}/{target} paired predictions, but no rate data yet"
               ),
           };
           CalibrationVerdict { cold_start: false, pairs, target_pairs: target, flagged_rate_pct, unflagged_rate_pct, pooled_accuracy_pct, perceives, line }
       }
       ```


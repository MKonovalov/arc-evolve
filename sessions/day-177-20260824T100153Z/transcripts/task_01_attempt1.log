```rust
/// Plain-language calibration verdict for the risk sense organ — the dream's
/// "does the umwelt correspond to the territory" answer.
pub(crate) struct CalibrationVerdict {
    /// true when accumulated pairs have reached the target (calibrated reading).
    pub(crate) calibrated: bool,
    /// Raw verdict line with no color codes (for files/tests).
    pub(crate) line: String,
}

/// Interpret pooled prediction-outcome pairs into a one-line, plain-language
/// verdict. Cold start (< target pairs): honest status line, NO accuracy
/// claims. Calibrated (>= target pairs): pooled flagged vs unflagged breakage
/// rates plus pooled accuracy, and a blunt "perceives / does not yet perceive"
/// judgment.
pub(crate) fn calibration_verdict(
    pairs: u64,
    target_pairs: u64,
    events: &[ValidationEvent],
) -> CalibrationVerdict {
    if pairs < target_pairs {
        return CalibrationVerdict {
            calibrated: false,
            line: format!("cold start: {pairs}/{target_pairs} paired predictions — accumulating"),
        };
    }

    // Pooled discriminative readout over events carrying the lift fields.
    let mut flagged_broke = 0usize; // hits: flagged files that broke
    let mut flagged_total = 0usize; // predicted_count: the flagged population
    let mut unflagged_broke = 0usize; // scored surprise count
    let mut unflagged_total = 0usize; // total_scored - predicted_count
    let mut change_total = 0usize; // total_changed (pooled accuracy denominator)
    for e in events {
        change_total += e.total_changed;
        if let (Some(pred), Some(total_scored), Some(scored_broke)) =
            (e.predicted_count, e.total_scored, e.scored_broke)
        {
            flagged_broke += e.hit_count;
            flagged_total += pred;
            let surprises = scored_broke.saturating_sub(e.hit_count);
            unflagged_broke += surprises;
            unflagged_total += total_scored.saturating_sub(pred);
        }
    }

    let flagged_rate = if flagged_total > 0 { flagged_broke as f64 / flagged_total as f64 } else { 0.0 };
    let unflagged_rate = if unflagged_total > 0 { unflagged_broke as f64 / unflagged_total as f64 } else { 0.0 };
    let pooled_accuracy = if change_total > 0 { flagged_broke as f64 / change_total as f64 } else { 0.0 };
    ...
    let verdict = if flagged_total > 0 && unflagged_total > 0 && flagged_rate > unflagged_rate {
        "perceives"
    } else {
        "does not yet perceive"
    };
    ...render...
}
```


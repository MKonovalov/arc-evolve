   ```rust
   pub(crate) fn calibration_verdict(
       pairs: u64,
       events: &[ValidationEvent],
       target_pairs: u64,
   ) -> CalibrationVerdict {
       let mut hit_sum = 0usize;
       let mut predicted_sum = 0usize;
       let mut total_scored_sum = 0usize;
       let mut surprises_sum = 0usize;
       let mut changed_sum = 0usize;
       for e in events {
           if let (Some(pred), Some(total_scored), Some(scored_broke)) =
               (e.predicted_count, e.total_scored, e.scored_broke)
           {
               hit_sum += e.hit_count;
               predicted_sum += pred;
               total_scored_sum += total_scored;
               surprises_sum += e.total_changed.saturating_sub(e.hit_count);
               changed_sum += e.total_changed;
               let _ = scored_broke; // pairs already counted by the meter
           }
       }
       let flagged_rate = if predicted_sum > 0 {
           Some(hit_sum as f64 / predicted_sum as f64 * 100.0)
       } else { None };
       let unflagged_denom = total_scored_sum.saturating_sub(predicted_sum);
       let unflagged_rate = if unflagged_denom > 0 {
           Some(surprises_sum as f64 / unflagged_denom as f64 * 100.0)
       } else { None };
       let pooled_accuracy = if changed_sum > 0 {
           Some(hit_sum as f64 / changed_sum as f64 * 100.0)
       } else { None };
       let calibrated = pairs >= target_pairs;
       let perceives = calibrated
           && matches!((flagged_rate, unflagged_rate), (Some(f), Some(u)) if f > u);
       CalibrationVerdict {
           calibrated: pairs >= target_pairs,  // hmm compute once
           pairs, target_pairs,
           flagged_rate_pct: flagged_rate,
           unflagged_rate_pct: unflagged_rate,
           pooled_accuracy_pct: pooled_accuracy,
           perceives,
       }
   }
   ```


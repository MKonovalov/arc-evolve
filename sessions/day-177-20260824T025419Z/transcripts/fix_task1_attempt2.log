/// Pure scoring core: weighted composite + penalty + mutation + recency bump.
/// `norm` is the 7 normalized signals [churn, recency, size, complexity,
/// test_density, coupling, revert_history]; `recent_touch` adds the bump.
fn score_risk_file(norm: &[f64; 7], weights: &[f64; 7], recent_touch: bool, ms: f64, td: f64) -> f64 {
    let mut score = norm.iter().zip(weights).map(|(n, w)| n * w).sum::<f64>();
    if recent_touch {
        score += RECENT_TOUCH_BUMP;
    }
    if td < 5.0 {
        score += (5.0 - td) * 2.0 / 100.0;
    }
    if ms > 0.0 {
        score += MUTATION_WEIGHT * ms;
    }
    score
}
```


fn test_recently_touched_outranks_historically_fragile() {
    // Day-175 calibration: a one-off fix target (e.g. src/update.rs) with
    // modest churn/revert/coupling history but a recent touch must rank at or
    // above a file with a strong history that hasn't been touched recently.
    let weights = RISK_WEIGHTS;

    let recent = weighted_risk_score(0.15, 0.60, 0.30, 0.40, 0.70, 0.10, 0.0, true, &weights);
    let strong = weighted_risk_score(0.85, 0.0, 0.75, 0.65, 0.45, 0.85, 1.0, false, &weights);

    assert!(recent > strong, "recently-touched file must outrank historically-fragile one: recent={recent:.3} strong={strong:.3}");
    // Sanity: without the boost the same file loses — proving the boost, not
    // the recency signal alone, is what closes the gap.
    assert!(recent_base < strong);
    // and the boost is what flips the ranking
    assert!(recent - recent_base >= RECENT_TOUCH_BOOST - 1e-9);
}

```rust
/// Parse `git log --name-only` (with `--pretty=format:` so only paths remain)
/// and `git status --porcelain` output into the set of recently-touched
/// `src/**/*.rs` paths.
///
/// Pure helper (extracted so tests can pin the parsing without running git).
fn parse_recent_touched(
    log_output: &str,
    status_output: &str,
) -> std::collections::HashSet<String> {
    let mut out = std::collections::HashSet::new();
    for line in log_output.lines() {
        let path = line.trim();
        if path.starts_with("src/") && path.ends_with(".rs") {
            out.insert(path.to_string());
        }
    }
    for line in status_output.lines() {
        // porcelain format: <XY> <path> (with '??' for untracked, and
        // 'R old -> new' captures the destination via `.last()`).
        let path = line
            .split(' ')
            .filter(|s| !s.is_empty())
            .last()
            .map(str::trim)
            .unwrap_or("");
        if path.starts_with("src/") && path.ends_with(".rs") {
            out.insert(path.to_string());
        }
    }
    out
}
```


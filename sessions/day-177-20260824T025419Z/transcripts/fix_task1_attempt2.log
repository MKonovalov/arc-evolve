```rust
/// Composite risk score for one file from its normalized signals.
///
/// Pure helper (extracted so tests can pin the arithmetic and the
/// recency-bump ranking behavior without touching the live repo).
fn file_risk_score(
    norm_churn: f64,
    norm_recency: f64,
    norm_size: f64,
    norm_complexity: f64,
    norm_test: f64,
    norm_coupling: f64,
    norm_revert: f64,
    recently_touched: bool,
    td: f64,
    mutation_survival: f64,
    weights: &[f64; 7],
) -> f64 {
    let mut score = norm_churn * weights[0]
        + norm_recency * weights[1]
        + norm_size * weights[2]
        + norm_complexity * weights[3]
        + norm_test * weights[4]
        + norm_coupling * weights[5]
        + norm_revert * weights[6];

    // Penalty: files with fewer than 5 tests per 100 lines get a bump
    score += f64::max(0.0, (5.0 - td) * 2.0) / 100.0;

    // Mutation-survival signal...
    if mutation_survival > 0.0 {
        score += MUTATION_WEIGHT * mutation_survival;
    }

    // Recency bonus...
    if recently_touched {
        score += RECENCY_BONUS;
    }

    score
}
```


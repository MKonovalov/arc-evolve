C. Pure scoring helper:
```rust
/// Combine the seven normalized risk signals plus a binary recent-touch flag
/// into a single weighted risk score (the historical signals are also summed
/// with `weights`; the recency boost is added on top).
fn weighted_risk_score(
    churn: f64,
    recency: f64,
    size: f64,
    complexity: f64,
    test_density: f64,
    coupling: f64,
    revert: f64,
    recently_touched: bool,
    weights: &[f64; 7],
) -> f64 {
    let mut score = churn * weights[0]
        + recency * weights[1]
        + size * weights[2]
        + complexity * weights[3]
        + test_density * weights[4]
        + coupling * weights[5]
        + revert * weights[6];
    if recently_touched {
        score += RECENT_TOUCH_BOOST;
    }
    score
}
```


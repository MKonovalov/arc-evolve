```rust
/// Files touched within the last `RECENCY_COMMIT_WINDOW` commits OR modified
/// in the working tree (uncommitted / this session's own edits).
///
/// This is the "recently touched" signal that catches one-off fix targets
/// (e.g. the day-175 `src/update.rs` SemVer fix) that a 30-day churn window
/// and relative 7-day acceleration normalize away.
fn recently_touched_files() -> std::collections::HashSet<String> {
    let mut recent = std::collections::HashSet::new();

    // 1. Files in the last N commits.
    let window = RECENCY_COMMIT_WINDOW.to_string();
    if let Ok(output) = crate::git::run_git(&[
        "log",
        &format!("-{window}"),
        "--name-only",
        "--pretty=format:",
    ]) {
        for line in output.lines() {
            let path = line.trim();
            if path.starts_with("src/") && path.ends_with(".rs") {
                recent.insert(path.to_string());
            }
        }
    }

    // 2. Working-tree modifications (this session's own edits).
    if let Ok(output) = crate::git::run_git(&["status", "--porcelain"]) {
        for line in output.lines() {
            // Format: "XY path" — strip the two status codes and whitespace.
            let path = line.get(3..).unwrap_or("").trim();
            if path.starts_with("src/") && path.ends_with(".rs") {
                recent.insert(path.to_string());
            }
        }
    }


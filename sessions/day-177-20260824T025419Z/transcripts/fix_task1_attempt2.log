And score_risk_file:
```rust
/// Composite risk score for one file from its 7 normalized signals plus
/// contextual flags.
///
/// Pure helper (extracted so the day-175 calibration test can drive the
/// scoring with synthetic signals instead of live repo state).
fn score_risk_file(
    norm: &[f64; 7],
    weights: &[f64; 7],
    recent_touch: bool,
    mutation_survival: f64,
    tests_per_100: f64,
) -> f64 {
    // Weighted sum of the 7 normalized signals.
    let mut score: f64 = norm.iter().zip(weights.iter()).map(|(n, w)| n * w).sum();

    // Recency bump: files touched in the last `RECENT_COMMIT_WINDOW` commits
    // or modified in the working tree are the most likely next edit targets.
    // Deliberately additive so it can lift a modest one-off fix target above
    // a dormant file with strong historical signals.
    if recent_touch {
        score += RECENT_TOUCH_BUMP;
    }

    // Penalty: files with fewer than 5 tests per 100 lines get a bump
    // (all scored files here are .rs files where test density is meaningful).
    score += f64::max(0.0, (5.0 - tests_per_100) * 2.0) / 100.0;

    // Mutation-survival signal: bounded 0..MUTATION_WEIGHT so it complements
    // rather than dominates. Files without an entry contribute exactly 0.
    if mutation_survival > 0.0 {
        score += MUTATION_WEIGHT * mutation_survival;
    }

    score
}
```


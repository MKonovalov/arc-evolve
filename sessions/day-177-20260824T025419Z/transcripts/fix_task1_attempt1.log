/// Compute the weighted risk score from normalized signals plus the
/// recency-touch bump.
fn weighted_risk_score(
    weights: &[f64; 7],
    norm: &[f64; 7], // normalized signals in weight order
    recency_touch: f64, // 0..1
    recency_bump: f64,
) -> f64 {
    let mut s = 0.0;
    for i in 0..7 { s += norm[i] * weights[i]; }
    s + recency_bump * recency_touch
}
```


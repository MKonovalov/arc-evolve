fn file_score(
    churn: f64,
    accel: f64,
    size: f64,
    complexity: f64,
    test_density: f64,
    coupling: f64,
    revert: f64,
    touched_recently: bool,
    weights: [f64; 7],
    mutation_survival: f64,
    tests_per_100: f64,

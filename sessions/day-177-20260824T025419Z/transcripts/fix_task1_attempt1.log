/// Number of recent commits that define the "recently touched" window for the
/// recency weight bump. Chosen so a one-off fix target (e.g. the day-175
/// `src/update.rs` SemVer fix) is always inside the window.
const RECENCY_WINDOW_COMMITS: usize = 5;

/// Additive weight bump for files touched within `RECENCY_WINDOW_COMMITS`
/// commits (or modified in the working tree). Deliberately larger than the
/// per-signal weights (0.10–0.30) so historical fragility signals cannot drown
/// a fresh edit target — the exact calibration the day-175 miss demanded.
const RECENCY_BUMP: f64 = 0.20;
```

Wait, I need to decide the bump value after seeing test numbers. Let me first construct realistic synthetic test values from the day-175 snapshot (top scored 0.73, cutoff 0.29), then tune.

**2. `recently_touched_files()` function** (git-based, fail-soft):
```rust
/// Set of source files "touched recently": modified within the last
/// `RECENCY_WINDOW_COMMITS` commits, or carrying uncommitted working-tree
/// changes (this session's own edits). Fail-soft — an unavailable git working
/// tree yields an empty set and no recency signal.
fn recently_touched_files() -> std::collections::HashSet<String> {
    let mut recent = std::collections::HashSet::new();

    // Files touched by the last N commits.
    if let Ok(output) = crate::git::run_git(&[
        "log",
        &format!("-n {}", RECENCY_WINDOW_COMMITS),
        "--name-only",
        "--pretty=format:",
    ]) {
        for line in output.lines() {
            let path = line.trim();
            if path.is_empty() { continue; }
            if path.starts_with("src/") && path.ends_with(".rs") {
                recent.insert(path.to_string());
            }
        }
    }

    // Files with uncommitted changes (this session's own edits).
    if let Ok(output) = crate::git::run_git(&["status", "--porcelain"]) {
        for line in output.lines() {
            // porcelain: XY path / XY "path with spaces"
            let trimmed = line.trim_start();
            let path = if trimmed.len() > 3 {
                trimmed[3..].trim_matches('"').to_string()
            } else {
                trimmed.to_string()
            };
            if path.starts_with("src/") && path.ends_with(".rs") {
                recent.insert(path);
            }
        }
    }

    recent
}
```

Note run_git has a `#[cfg(test)]` destructive-command guard for destructive subcommands — `git log` and `git status` are non-destructive, safe.


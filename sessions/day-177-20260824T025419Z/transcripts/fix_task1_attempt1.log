```rust
/// Pure core of the per-file score: weighted sum of normalized signals plus
/// bounded additive terms (test-density penalty, mutation survival, recency bump).
/// Extracted so the day-176 recency calibration can be unit-tested without
/// live repo state.
fn score_for_file(
    norm: &[f64],              // 7 normalized signals in RISK_WEIGHTS order
    weights: &[f64; 7],
    is_rs: bool,
    td: f64,
    mutation_survival: f64,
    recent_bump: f64,          // 0.0..=1.0 recency decay (0 = not recently touched)
) -> f64 {
    let mut score = 0.0;
    for (i, w) in weights.iter().enumerate() {
        score += norm[i] * w;
    }
    if is_rs {
        score += f64::max(0.0, (5.0 - td) * 2.0) / 100.0;
    }
    if mutation_survival > 0.0 {
        score += MUTATION_WEIGHT * mutation_survival;
    }
    if recent_bump > 0.0 {
        score += RECENT_TOUCH_WEIGHT * recent_bump;
    }
    score
}
```


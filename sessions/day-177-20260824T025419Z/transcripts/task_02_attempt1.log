In commands_risk_accuracy.rs:

```rust
/// The hit/miss decomposition of one validation event: the intersection of
/// predicted and actually-changed files, plus the two one-sided miss sets.
/// This is the "look at a miss" evidence behind the aggregate accuracy number.
pub(crate) struct HitMissSets {
    /// Predicted high-risk AND changed: the prediction was confirmed.
    pub(crate) hits: Vec<String>,
    /// Predicted high-risk but untouched: a false alarm (the scorer cried wolf).
    pub(crate) predicted_untouched: Vec<String>,
    /// Changed but not predicted: a miss (the sense organ didn't see it).
    pub(crate) touched_unpredicted: Vec<String>,
}

/// Pure hit/miss intersection: `changed` ∩ `predicted` vs each one-sided miss
/// set. Order-preserving on both inputs; used by the last-validation detail
/// block so `/risk accuracy` readers can *look at* a miss, not just read a %
/// (the product-facing half of the calibration loop).
pub(crate) fn compute_hit_miss_sets(predicted: &[String], changed: &[String]) -> HitMissSets {
    let predicted_set: std::collections::HashSet<&str> =
        predicted.iter().map(|s| s.as_str()).collect();
    let changed_set: std::collections::HashSet<&str> =
        changed.iter().map(|s| s.as_str()).collect();

    let hits: Vec<String> = predicted
        .iter()
        .filter(|p| changed_set.contains(p.as_str()))
        .cloned()
        .collect();
    let predicted_untouched: Vec<String> = predicted
        .iter()
        .filter(|p| !changed_set.contains(p.as_str()))
        .cloned()
        .collect();
    let touched_unpredicted: Vec<String> = changed
        .iter()
        .filter(|c| !predicted_set.contains(c.as_str()))
        .cloned()
        .collect();

    HitMissSets {
        hits,
        predicted_untouched,
        touched_unpredicted,
    }
}

/// Format the "last validation" detail block for the `/risk accuracy` report:
/// the most recent validation event's predicted-vs-changed decomposition, so a
/// 0% day is legible as "we predicted X, the session touched Y, and the two
/// never met". Reuses the shared parsers (`parse_validation_events` from
/// commands_risk_snapshots.rs, `parse_all_snapshots` for the predicted list).
/// Pure — no I/O; content strings come from the caller.
pub(crate) fn format_last_validation_block(
    validation_content: &str,
    snapshot_content: &str,
) -> String {
    let events = parse_validation_events(validation_content);
    let Some(last) = events.last() else {
        return format!(
            "{DIM}  Last validation: no validation data yet — the sense organ has no signal to calibrate on.{RESET}\n"
        );
    };

    // Find the snapshot the event validated: prefer an exact git-hash match
    // (the event records `git_hash_from`), else fall back to the last snapshot
    // with day <= event day, else the most recent snapshot.
    let snapshots = parse_all_snapshots(snapshot_content);
    let predicted: Vec<String> = snapshots
        .iter()
        .rev()
        .find(|s| {
            last.git_hash_from
                .as_deref()
                .is_some_and(|h| h == s.git_hash)
        })
        .or_else(|| {
            snapshots
                .iter()
                .rev()
                .find(|s| s.day <= last.day as u64)
        })
        .map(|s| s.predicted.clone())
        .unwrap_or_default();

    let mut changed: Vec<String> = last.hits.clone();
    changed.extend(last.surprises.iter().cloned());

    let sets = compute_hit_miss_sets(&predicted, &changed);

    let mut out = format!(
        "\n{BOLD}  Last Validation (day {}){RESET}\n",
        last.day
    );
    out.push_str(&format!(
        "  {DIM}predicted {}/{} high-risk files; {} changed; {}% accuracy{RESET}\n",
        predicted.len(),
        last.predicted_count.unwrap_or(predicted.len()),
        changed.len(),
        last.accuracy_pct,
    ));
    ...
}
```


```rust
/// Pure composite-score computation for a single file, extracted from
/// `compute_file_risk_scores` so the recency-vs-history tradeoff can be pinned
/// by tests without reading the live repo.
fn composite_risk_score(
    signals: [f64; 7],      // normalized churn, accel, size, complexity, test_density, coupling, revert
    weights: [f64; 7],
    mutation_survival: f64,
    test_density: f64,
    recent_touched: bool,
) -> f64 {
    let mut score = 0.0;
    for i in 0..7 {
        score += signals[i] * weights[i];
    }
    if test_density >= 0.0 {  // .rs penalty
        score += f64::max(0.0, (5.0 - test_density) * 2.0) / 100.0;
    }
    if mutation_survival > 0.0 {
        score += MUTATION_WEIGHT * mutation_survival;
    }
    if recent_touched {
        score += RECENCY_BUMP;
    }
    score
}
```


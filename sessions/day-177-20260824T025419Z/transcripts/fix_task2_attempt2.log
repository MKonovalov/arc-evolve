#[test]
fn test_compute_hit_miss_sets_partitions_hits_and_misses() {
    let predicted = vec!["src/commands_risk.rs", "src/commands_risk_accuracy.rs", "src/watch.rs"];
    let changed = vec!["src/commands_risk_accuracy.rs", "src/update.rs"];
    let (hits, predicted_untouched, touched_unpredicted) = compute_hit_miss_sets(&predicted, &changed);

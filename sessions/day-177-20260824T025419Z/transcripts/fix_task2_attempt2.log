Now `load_last_validation_detail`:

```rust
/// Gather the "last validation" evidence block for the accuracy report:
/// the scorer's high-risk predictions from the snapshot a validation was
/// validated against, the files that actually changed in the validating
/// commits, and the hit/miss partition.
///
/// Reuses the existing JSONL parsers (`parse_rich_validation_events`,
/// `parse_all_snapshots`) — no new file formats. The snapshot association is
/// the same key the harness dedups on: the validation's `git_hash_from` must
/// match a snapshot's `git_hash`. Returns `None` when there is no usable
/// record yet (cold start) or the last event can't be paired with a snapshot.
fn load_last_validation_detail(
    validation_content: &str,
    snapshot_content: &str,
) -> Option<LastValidationDetail> {
    let last = parse_rich_validation_events(validation_content).last()?;
    if last.git_hash_from.is_empty() {
        return None; // legacy event without an association — nothing to pair
    }
    let snapshot = parse_all_snapshots(snapshot_content)
        .into_iter()
        .find(|s| s.git_hash == last.git_hash_from)?;
    let changed: Vec<String> = last
        .hits
        .iter()
        .chain(last.surprises.iter())
        .cloned()
        .collect();
    let (hits, predicted_untouched, touched_unpredicted) =
        compute_hit_miss_sets(&snapshot.predicted, &changed);
    Some(LastValidationDetail {
        day: last.day,
        ts: last.ts.clone(),
        accuracy_pct: last.accuracy_pct,
        predicted: snapshot.predicted.clone(),
        changed: changed.clone(),
        hits,
        predicted_untouched,
        touched_unpredicted,
    })
}
```


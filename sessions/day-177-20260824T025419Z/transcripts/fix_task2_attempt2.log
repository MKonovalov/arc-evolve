    assert_eq!(predicted_untouched, vec!["src/commands_risk.rs", "src/watch.rs"]);
    assert_eq!(touched_unpredicted, vec!["src/update.rs"]);
}

#[test]
fn test_compute_hit_miss_sets_both_missed_case() {
    // Disjoint lists — zero hits, everything is a miss.
    let predicted = vec!["src/a.rs", "src/b.rs"];
    let changed = vec!["src/c.rs"];
    let (hits, predicted_untouched, touched_unpredicted) = compute_hit_miss_sets(&predicted, &changed);

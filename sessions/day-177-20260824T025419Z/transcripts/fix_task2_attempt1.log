Let me design the formatter to take the predicted list, changed list, and day, and compute the hit/miss inside (pure function). That way the unit test can be on both `compute_hit_miss` and the formatter.

```rust
pub(crate) struct HitMissSet {
    pub(crate) hits: Vec<String>,
    pub(crate) predicted_untouched: Vec<String>,
    pub(crate) changed_unpredicted: Vec<String>,
}

pub(crate) fn compute_hit_miss(predicted: &[String], changed: &[String]) -> HitMissSet {
    let predicted_set: HashSet<&str> = predicted.iter().map(|s| s.as_str()).collect();
    let changed_set: HashSet<&str> = changed.iter().map(|s| s.as_str()).collect();
    let mut hits = Vec::new();
    for p in predicted {
        if changed_set.contains(p.as_str()) {
            hits.push(p.clone());
        }
    }
    let mut predicted_untouched: Vec<String> = predicted
        .iter()
        .filter(|p| !changed_set.contains(p.as_str()))
        .cloned()
        .collect();
    let mut changed_unpredicted: Vec<String> = changed
        .iter()
        .filter(|c| !predicted_set.contains(c.as_str()))
        .cloned()
        .collect();
    // sort for stable display
    hits.sort();
    predicted_untouched.sort();
    changed_unpredicted.sort();
    HitMissSet { hits, predicted_untouched, changed_unpredicted }
}
```


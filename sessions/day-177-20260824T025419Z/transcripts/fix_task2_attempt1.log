```rust
/// The hit/miss intersection of a single validation: which predicted files
/// actually changed, which predicted files stayed untouched, and which
/// changed files were never predicted.
#[derive(Debug, PartialEq, Default)]
pub(crate) struct MissView {
    pub(crate) hits: Vec<String>,
    pub(crate) predicted_untouched: Vec<String>,
    pub(crate) touched_unpredicted: Vec<String>,
}

pub(crate) fn compute_miss_view(predicted: &[String], changed: &[String]) -> MissView {
    let predicted_set: HashSet<&str> = predicted.iter().map(String::as_str).collect();
    let changed_set: HashSet<&str> = changed.iter().map(String::as_str).collect();
    let mut hits: Vec<String> = predicted.iter().filter(|p| changed_set.contains(p.as_str())).cloned().collect();
    let mut predicted_untouched: Vec<String> = predicted.iter().filter(|p| !changed_set.contains(p.as_str())).cloned().collect();
    let mut touched_unpredicted: Vec<String> = changed.iter().filter(|c| !predicted_set.contains(c.as_str())).cloned().collect();
    hits.sort();
    predicted_untouched.sort();
    touched_unpredicted.sort();
    MissView { hits, predicted_untouched, touched_unpredicted }
}
```


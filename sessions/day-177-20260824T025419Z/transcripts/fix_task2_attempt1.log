   And the intersection computation, pure and testable:

   ```rust
   /// Partition the union of predicted and changed files into hits vs misses.
   ///
   /// Returns (hits, predicted_untouched, touched_unpredicted) — each sorted for
   /// stable display. The miss set is `predicted_untouched ++ touched_unpredicted`.
   pub(crate) fn compute_hit_miss_sets(
       predicted: &[String],
       changed: &[String],
   ) -> (Vec<String>, Vec<String>, Vec<String>) {
       let predicted_set: std::collections::HashSet<&str> =
           predicted.iter().map(|s| s.as_str()).collect();
       let changed_set: std::collections::HashSet<&str> =
           changed.iter().map(|s| s.as_str()).collect();

       let mut hits = Vec::new();
       let mut predicted_untouched = Vec::new();
       let mut touched_unpredicted = Vec::new();
       for f in predicted {
           if changed_set.contains(f.as_str()) {
               hits.push(f.clone());
           } else {
               predicted_untouched.push(f.clone());
           }
       }
       for f in changed {
           if !predicted_set.contains(f.as_str()) {
               touched_unpredicted.push(f.clone());
           }
       }
       hits.sort();
       predicted_untouched.sort();
       touched_unpredicted.sort();
       (hits, predicted_untouched, touched_unpredicted)
   }
   ```


   ```rust
   /// Render up to `max` file entries as bullet lines, with a "+N more" tail.
   fn fmt_file_lines(paths: &[String], max: usize) -> String {
       if paths.is_empty() {
           return String::new();
       }
       let mut out = String::new();
       let shown = paths.len().min(max);
       for p in &paths[..shown] {
           out.push_str(&format!("      • {p}\n"));
       }
       if paths.len() > shown {
           out.push_str(&format!("      {DIM}… +{} more{RESET}\n", paths.len() - shown));
       }
       out
   }

fn build_last_validation_detail(
    events: &[RichValidationEvent],
    snap_hash_to_predicted: &std::collections::HashMap<String, Vec<String>>,
) -> String {
    let Some(last) = events.last() else { return String::new(); };
    let changed: Vec<String> = last.hits.iter().chain(last.surprises.iter()).cloned().collect();
    let mut predicted: Vec<String> = Vec::new();
    let mut snapshot_note = String::new();
    if let Some(p) = snap_hash_to_predicted.get(&last.git_hash_from) {
        predicted = p.clone();
    } else if !last.git_hash_from.is_empty() {
        snapshot_note = format!(
            "  {DIM}  (no snapshot recorded for {}){RESET}\n",
            last.git_hash_from
        );
    }
    let view = compute_miss_view(&predicted, &changed);
    let mut out = format_last_validation_block(last.day, last.accuracy_pct, &view);
    out.push_str(&snapshot_note);
    out
}
```


    let hm = compute_hit_miss(&predicted, &changed);
    // hits preserve predicted order
    assert_eq!(hm.hits, vec!["src/a.rs", "src/b.rs"]);
    assert!(hm.missed_predictions.is_empty());
    assert!(hm.unpredicted_changes.is_empty());

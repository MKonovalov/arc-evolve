For `compute_change_misses`:
```rust
/// The miss set of a single prediction-outcome pair: which predicted files
/// were never touched, and which touched files were never predicted.
pub(crate) struct ChangeMiss {
    pub(crate) hits: Vec<String>,
    pub(crate) predicted_unhit: Vec<String>,
    pub(crate) touched_unpredicted: Vec<String>,
}

pub(crate) fn compute_change_misses(predicted: &[String], changed: &[String]) -> ChangeMiss {
    let pred_set: BTreeSet<&str> = predicted.iter().map(String::as_str).collect();
    let changed_set: BTreeSet<&str> = changed.iter().map(String::as_str).collect();
    let mut hits: Vec<String> = predicted
        .iter()
        .filter(|p| changed_set.contains(p.as_str()))
        .cloned()
        .collect();
    hits.sort();
    hits.dedup();
    let mut predicted_unhit: Vec<String> = predicted
        .iter()
        .filter(|p| !changed_set.contains(p.as_str()))
        .cloned()
        .collect();
    predicted_unhit.sort();
    predicted_unhit.dedup();
    let mut touched_unpredicted: Vec<String> = changed
        .iter()
        .filter(|c| !pred_set.contains(c.as_str()))
        .cloned()
        .collect();
    touched_unpredicted.sort();
    touched_unpredicted.dedup();
    ChangeMiss { hits, predicted_unhit, touched_unpredicted }
}
```

For the format fn — a pure, formatting-only function:
```rust
pub(crate) fn format_last_validation_block(
    day: u32,
    predicted: &[String],
    changed: &[String],
    miss: &ChangeMiss,
) -> String {
    if predicted.is_empty() && changed.is_empty() {
        return format!("\n{BOLD}  Last Validation{RESET}\n  {DIM}No validation data yet.{RESET}\n");
    }
    let mut out = format!("\n{BOLD}  Last Validation — Day {day}{RESET}\n");
    out.push_str(&format!(
        "  {DIM}Predicted {}(high-risk){RESET}   {DIM}Changed {}(in validating commits){RESET}\n",
        predicted.len(), changed.len()
    ));
    if predicted.is_empty() {
        out.push_str(&format!("  {RED}✗ Predicted: (none){RESET}\n"));
    } else {
        out.push_str(&format!("  Predicted:    {}\n", predicted.join(", ")));
    }
    if changed.is_empty() {
        out.push_str(&format!("  {RED}✗ Changed: (none){RESET}\n"));
    } else {
        out.push_str(&format!("  Changed:      {}\n", changed.join(", ")));
    }
    // Hits
    if miss.hits.is_empty() {
        out.push_str(&format!("  {RED}✓ Hits: (none){RESET}\n"));
    } else {
        out.push_str(&format!("  {GREEN}✓ Hits (predicted ∩ changed): {}{RESET}\n", miss.hits.join(", ")));
    }
    if !miss.predicted_unhit.is_empty() {
        out.push_str(&format!("  {YELLOW}✗ Predicted but untouched: {}{RESET}\n", miss.predicted_unhit.join(", ")));
    }
    if !miss.touched_unpredicted.is_empty() {
        out.push_str(&format!("  {RED}✗ Changed but not predicted: {}{RESET}\n", miss.touched_unpredicted.join(", ")));
    }
    out
}
```


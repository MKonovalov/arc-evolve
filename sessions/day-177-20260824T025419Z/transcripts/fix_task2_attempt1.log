#[test]
fn test_compute_miss_view_intersection() {
    let predicted = vec![
        "src/commands_risk.rs".to_string(),
        "src/commands_risk_accuracy.rs".to_string(),
        "src/commands_risk_snapshots.rs".to_string(),
    ];
    let changed = vec![
        "src/commands_risk.rs".to_string(),   // hit
        "src/update.rs".to_string(),          // surprise
    ];
    let view = compute_miss_view(&predicted, &changed);
    assert_eq!(view.hits, vec!["src/commands_risk.rs".to_string()]);
    assert_eq!(view.predicted_untouched, vec![
        "src/commands_risk_accuracy.rs".to_string(),
        "src/commands_risk_snapshots.rs".to_string(),
    ]);
    assert_eq!(view.touched_unpredicted, vec!["src/update.rs".to_string()]);
}


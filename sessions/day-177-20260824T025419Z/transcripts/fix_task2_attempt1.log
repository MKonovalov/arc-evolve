   /// A single file's fate in the last validation: was it predicted high-risk,
   /// and did it actually change?
   #[derive(Debug, PartialEq, Eq, Clone, Copy)]
   pub(crate) enum MissKind {
       /// Predicted AND changed — a hit (correct call).
       Hit,
       /// Predicted high-risk but never touched in the validating commits.
       PredictedUntouched,
       /// Touched but never predicted — a surprise miss.
       TouchedUnpredicted,

        "src/cli.rs".to_string(),     // changed but not predicted
    ];
    let hm = compute_hit_miss(&predicted, &changed);
    assert_eq!(hm.hits, vec!["src/commands_risk.rs", "src/commands_risk_snapshots.rs"]);
    assert_eq!(hm.missed_predictions, vec!["src/commands_risk_accuracy.rs", "src/update.rs"]);
    assert_eq!(hm.unpredicted_changes, vec!["src/cli.rs"]);
}

#[test]

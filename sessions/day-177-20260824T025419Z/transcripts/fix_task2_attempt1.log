```rust
/// Build the file-level detail of the most recent validation round for the
/// hit/miss block: the predicted high-risk list (from the snapshot the round
/// was validated against, matched by `git_hash_from`) and the files that
/// actually changed (hits + surprises, in recorded order).
fn last_validation_detail(
    validation_content: &str,
    snapshot_content: &str,
) -> Option<LastValidationDetail> {
    let events = parse_rich_validation_events(validation_content);
    let last = events.last()?;

    // The rich parser drops git_hash_from/to; recover them from the last
    // non-empty validation line (same JSONL `parse_validation_events` reads).
    let line = validation_content
        .lines()
        .rev()
        .find(|l| !l.trim().is_empty())?;
    let val: serde_json::Value = serde_json::from_str(line.trim()).ok()?;
    let git_hash_from = val["git_hash_from"].as_str().unwrap_or("unknown").to_string();
    let git_hash_to = val["git_hash_to"].as_str().unwrap_or("unknown").to_string();

    // Snapshot being validated: latest snapshot whose git hash matches the
    // event's `git_hash_from`. Reuses the snapshot parser unchanged.
    let predicted = parse_all_snapshots(snapshot_content)
        .iter()
        .rev()
        .find(|s| s.git_hash == git_hash_from)
        .map(|s| s.predicted.clone())
        .unwrap_or_default();

    let mut changed = last.hits.clone();
    changed.extend(last.surprises.iter().cloned());

    Some(LastValidationDetail {
        day: last.day,
        git_hash_from,
        git_hash_to,
        predicted,
        changed,
        accuracy_pct: last.accuracy_pct,
    })
}
```

parse_all_snapshots is re-exported (line 15). parse_rich_validation_events is local. LastValidationDetail needs re-export from commands_risk_accuracy (add to the use at line 40).


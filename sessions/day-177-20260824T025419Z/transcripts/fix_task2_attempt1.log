// ── Last-validation miss set ──

/// The hit/miss intersection of a single validation: which predicted files
/// actually changed (hits), which predicted files stayed untouched, and which
/// changed files were never predicted (surprises beyond the prediction list).
#[derive(Debug, Default, PartialEq)]
pub(crate) struct MissView {
    hits: Vec<String>,
    predicted_untouched: Vec<String>,
    touched_unpredicted: Vec<String>,
}

/// Compute the hit/miss sets for one validation record: predicted (from the
/// snapshot taken at `git_hash_from`) vs changed (hits + surprises as recorded
/// in the validation event). Pure set arithmetic — no filesystem, no git.
pub(crate) fn compute_miss_view(predicted: &[String], changed: &[String]) -> MissView {
    let predicted_set: std::collections::HashSet<&str> =
        predicted.iter().map(|s| s.as_str()).collect();
    let changed_set: std::collections::HashSet<&str> =
        changed.iter().map(|s| s.as_str()).collect();

    let mut hits: Vec<String> = predicted
        .iter()
        .filter(|p| changed_set.contains(p.as_str()))
        .cloned()
        .collect();
    let mut predicted_untouched: Vec<String> = predicted
        .iter()
        .filter(|p| !changed_set.contains(p.as_str()))
        .cloned()
        .collect();
    let mut touched_unpredicted: Vec<String> = changed
        .iter()
        .filter(|c| !predicted_set.contains(c.as_str()))
        .cloned()
        .collect();

    hits.sort();
    predicted_untouched.sort();
    touched_unpredicted.sort();

    MissView {
        hits,
        predicted_untouched,
        touched_unpredicted,
    }
}

/// Render the "last validation" detail block: the predicted set, the changed
/// set, and — the calibration evidence — exactly which predictions missed.
/// `day`/`accuracy_pct` come from the validation event; the sets from
/// `compute_miss_view`. Pure formatting.
pub(crate) fn format_last_validation_block(day: u32, accuracy_pct: f64, view: &MissView) -> String {
    let predicted_total = view.hits.len() + view.predicted_untouched.len();
    let changed_total = view.hits.len() + view.touched_unpredicted.len();
    let mut out = format!("\n{BOLD}  Last Validation — Hit/Miss Set{RESET}\n");
    out.push_str(&format!(
        "  {DIM}Day {day} — {:.0}% accuracy — {predicted_total} predicted, {changed_total} changed{RESET}\n",
        accuracy_pct
    ));
    out.push_str(&format!(
        "  {GREEN}✓ Hits (predicted & changed):{RESET} {}\n",
        join_paths_compact(&view.hits)
    ));
    out.push_str(&format!(
        "  {YELLOW}✗ Predicted but untouched:{RESET} {}\n",
        join_paths_compact(&view.predicted_untouched)
    ));
    out.push_str(&format!(
        "  {RED}✗ Changed but not predicted:{RESET} {}\n",
        join_paths_compact(&view.touched_unpredicted)
    ));
    out
}

/// Join a file list for display, capping at 6 entries with a "+N more" tail so
/// a 10-file prediction miss stays legible without a wall of lines.
fn join_paths_compact(paths: &[String]) -> String {
    const CAP: usize = 6;
    if paths.is_empty() {
        return "(none)".to_string();
    }
    let shown: Vec<&str> = paths.iter().take(CAP).map(String::as_str).collect();
    let mut s = shown.join(", ");
    if paths.len() > CAP {
        s.push_str(&format!(", ... +{} more", paths.len() - CAP));
    }
    s
}
```


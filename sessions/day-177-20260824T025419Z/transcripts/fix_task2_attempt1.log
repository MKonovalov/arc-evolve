fn test_compute_miss_view_both_missed() {
    // No overlap — zero hits, all predicted untouched, all changed surprises.
    let predicted = vec!["src/a.rs".to_string(), "src/b.rs".to_string()];
    let changed = vec!["src/c.rs".to_string(), "src/d.rs".to_string()];
    let view = compute_miss_view(&predicted, &changed);
    assert!(view.hits.is_empty());

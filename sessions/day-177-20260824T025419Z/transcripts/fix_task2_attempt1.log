pub(crate) fn format_last_validation_block(day: u32, accuracy_pct: f64, view: &MissView) -> String {
    let predicted_total = view.hits.len() + view.predicted_untouched.len();
    let changed_total = view.hits.len() + view.touched_unpredicted.len();
    let mut out = format!("\n{BOLD}  Last Validation — Miss Set{RESET}\n");
    out.push_str(&format!(
        "  {DIM}Day {day} — {:.0}% accuracy — {predicted_total} predicted, {changed_total} changed{RESET}\n",
        accuracy_pct
    ));
    out.push_str(&format!("  {GREEN}✓ Hits (predicted & changed):{RESET} {}\n", join_or_none(&view.hits)));
    out.push_str(&format!("  {YELLOW}✗ Predicted but untouched:{RESET} {}\n", join_or_none(&view.predicted_untouched)));
    out.push_str(&format!("  {RED}✗ Changed but not predicted:{RESET} {}\n", join_or_none(&view.touched_unpredicted)));
    out
}


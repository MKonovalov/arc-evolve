           .find(|s| !event.git_hash_from.is_empty() && s.git_hash == event.git_hash_from)
           .or_else(|| {
               snapshots.iter().rev().find(|s| s.day <= u64::from(event.day))
           })
           .map(|s| s.predicted.clone())
           .unwrap_or_default();

       let mut changed = event.hits.clone();
       changed.extend(event.surprises.iter().cloned());

       let (hits, predicted_untouched, touched_unpredicted) =
           compute_hit_miss_sets(&predicted, &changed);

       Some(LastValidationDetail {
           day: event.day,
           ts: event.ts.clone(),
           accuracy_pct: event.accuracy_pct,
           predicted,
           changed,
           hits,
           predicted_untouched,
           touched_unpredicted,
       })
   }

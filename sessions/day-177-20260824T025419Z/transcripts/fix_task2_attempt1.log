```rust
/// Build the "last validation" hit/miss detail block: the most recent
/// validation event's predicted set (from the snapshot at its `git_hash_from`)
/// vs the files that actually changed, via `compute_miss_view`. Pure
/// formatting — no filesystem reads here.
fn build_last_validation_detail(
    events: &[RichValidationEvent],
    snap_hash_to_predicted: &std::collections::HashMap<String, Vec<String>>,
) -> String {
    let Some(last) = events.last() else {
        return String::new();
    };
    let changed: Vec<String> = last
        .hits
        .iter()
        .chain(last.surprises.iter())
        .cloned()
        .collect();
    let predicted = snap_hash_to_predicted
        .get(&last.git_hash_from)
        .cloned()
        .unwrap_or_default();
    let view = compute_miss_view(&predicted, &changed);
    let mut out = format_last_validation_block(last.day, last.accuracy_pct, &view);
    if predicted.is_empty() && !changed.is_empty() {
        out.push_str(&format!(
            "  {DIM}(no snapshot recorded for {} — predictions unknown){RESET}\n",
            last.git_hash_from
        ));
    }
    out
}
```


#[test]
fn test_compute_miss_view_intersection() {
    // Day-172-style: two predicted files changed (hits), one changed file was
    // never predicted (surprise), and the remaining predicted files stayed put.
    let predicted = vec![
        "src/commands_risk.rs".to_string(),
        "src/commands_risk_snapshots.rs".to_string(),
        "src/commands_risk_accuracy.rs".to_string(),
    ];
    let changed = vec![
        "src/commands_risk.rs".to_string(),
        "src/commands_risk_snapshots.rs".to_string(),
        "src/cli.rs".to_string(),
    ];
    let view = compute_miss_view(&predicted, &changed);
    assert_eq!(
        view.hits,
        vec!["src/commands_risk.rs".to_string(), "src/commands_risk_snapshots.rs".to_string()]
    );
    assert_eq!(view.predicted_untouched, vec!["src/commands_risk_accuracy.rs".to_string()]);
    assert_eq!(view.touched_unpredicted, vec!["src/cli.rs".to_string()]);
}

#[test]
fn test_compute_miss_view_both_missed() {
    // Day-175-style: disjoint sets — zero hits, every prediction missed.
    let predicted = vec![
        "src/commands_risk.rs".to_string(),
        "src/watch.rs".to_string(),
    ];
    let changed = vec!["src/update.rs".to_string()];

// ── Last-validation hit/miss detail (the product-facing evidence) ──

/// The hit/miss decomposition of one validation round: predicted vs changed.
#[derive(Debug, PartialEq)]
pub(crate) struct HitMiss {
    /// Predicted high-risk files that actually changed (intersection).
    pub(crate) hits: Vec<String>,
    /// Predicted high-risk files that stayed untouched (predicted-but-missed).
    pub(crate) missed_predictions: Vec<String>,
    /// Changed files never predicted (touched-but-unpredicted surprises).
    pub(crate) unpredicted_changes: Vec<String>,
}

/// Compute the hit/miss sets for a validation round: the scorer's predicted
/// high-risk list vs the files actually changed in the validating commits.
/// Ordering: hits and missed predictions keep the predicted order; unpredicted
/// changes keep the changed order. A file is a hit iff it appears in both lists.
pub(crate) fn compute_hit_miss(predicted: &[String], changed: &[String]) -> HitMiss {
    let predicted_set: std::collections::HashSet<&str> =
        predicted.iter().map(|s| s.as_str()).collect();
    let changed_set: std::collections::HashSet<&str> =
        changed.iter().map(|s| s.as_str()).collect();

    let mut hits = Vec::new();
    let mut missed_predictions = Vec::new();
    for p in predicted {
        if changed_set.contains(p.as_str()) {
            hits.push(p.clone());
        } else {
            missed_predictions.push(p.clone());
        }
    }

    let mut unpredicted_changes = Vec::new();
    for c in changed {
        if !predicted_set.contains(c.as_str()) {
            unpredicted_changes.push(c.clone());
        }
    }

    HitMiss {
        hits,
        missed_predictions,
        unpredicted_changes,
    }
}

/// File-level detail of the most recent validation round, for the
/// "last validation" block in `/risk accuracy`.
pub(crate) struct LastValidationDetail {
    /// Day of the validation event.
    pub(crate) day: u32,
    /// Snapshot git hash this round was validated against (`git_hash_from`).
    pub(crate) git_hash_from: String,
    /// Commit the validation ran through (`git_hash_to`).
    pub(crate) git_hash_to: String,
    /// Files the scorer predicted as high-risk (snapshot top-10). Empty if no
    /// matching snapshot could be found.
    pub(crate) predicted: Vec<String>,
    /// Files that actually changed across the validating commits
    /// (hits + surprises, in recorded order).
    pub(crate) changed: Vec<String>,
    /// Accuracy percentage of the round.
    pub(crate) accuracy_pct: f64,
}

/// Render the "last validation" detail block: predicted high-risk files vs the
/// files that actually changed, marking the intersection (hits) and the two
/// miss sets (predicted-but-untouched, touched-but-unpredicted). `None` prints
/// a clear "no validation data yet" line — the cold-start state is itself a
/// fact worth showing.
pub(crate) fn format_last_validation_block(detail: Option<&LastValidationDetail>) -> String {
    let Some(d) = detail else {
        return format!(
            "\n{BOLD}  Last Validation{RESET}\n  {DIM}No validation data yet — the scorer has not yet\n  {DIM}been checked against real changes. Run /risk snapshot{RESET}\n  {DIM}then /risk validate to close the loop.{RESET}\n"
        );
    };

    let hm = compute_hit_miss(&d.predicted, &d.changed);

    let mut out = format!(
        "\n{BOLD}  Last Validation — Day {} ({:.0}% accuracy){RESET}\n",
        d.day, d.accuracy_pct
    );
    let from_hash = short_hex(&d.git_hash_from);
    let to_hash = short_hex(&d.git_hash_to);
    out.push_str(&format!("  {DIM}Validated snapshot {from_hash} → {to_hash}{RESET}\n"));
    out.push_str(&format!(
        "  {BOLD}Predicted high-risk ({:>2}):{RESET} {}\n",
        d.predicted.len(),
        join_or_none(&d.predicted)
    ));
    out.push_str(&format!(
        "  {BOLD}Actually changed  ({:>2}):{RESET} {}\n",
        d.changed.len(),
        join_or_none(&d.changed)
    ));
    out.push_str(&format!(
        "  {GREEN}✓ Hit — predicted & changed ({:>2}):{RESET} {}\n",
        hm.hits.len(),
        join_or_none(&hm.hits)
    ));
    out.push_str(&format!(
        "  {YELLOW}✗ Miss — predicted but untouched ({:>2}):{RESET} {}\n",
        hm.missed_predictions.len(),
        join_or_none(&hm.missed_predictions)
    ));
    out.push_str(&format!(
        "  {RED}✗ Miss — changed but unpredicted ({:>2}):{RESET} {}\n",
        hm.unpredicted_changes.len(),
        join_or_none(&hm.unpredicted_changes)
    ));
    out
}

/// Join a file list with ", ", or render "(none)" when empty.
fn join_or_none(files: &[String]) -> String {
    if files.is_empty() {
        "(none)".to_string()
    } else {
        files.join(", ")
    }
}

/// Short 7-char git hash, char-boundary safe (hashes are ASCII hex, but stay safe).
fn short_hex(hash: &str) -> String {
    let end = hash.len().min(7);
    hash[..end].to_string()
}
```

Wait — `short_hex` uses `hash[..end]` which is byte slicing. Hash strings are hex ASCII so safe, but CLAUDE.md safety says never use byte indexing on strings. Even though hashes are ASCII, to be safe use is_char_boundary. Add guard:

```rust
fn short_hex(hash: &str) -> String {
    let mut end = hash.len().min(7);
    while end > 0 && !hash.is_char_boundary(end) {
        end -= 1;
    }
    hash[..end].to_string()
}

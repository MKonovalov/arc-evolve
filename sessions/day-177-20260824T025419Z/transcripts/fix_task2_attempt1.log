Where `last_validation_detail` is a small private fn in commands_risk.rs:

```rust
/// Build the file-level detail of the most recent validation round for the
/// hit/miss block: the predicted high-risk list (from the snapshot the round
/// was validated against) and the files that actually changed (hits+surprises).
fn last_validation_detail(
    validation_content: &str,
    snapshot_content: &str,
) -> Option<LastValidationDetail> {
    let events = parse_rich_validation_events(validation_content);
    let last = events.last()?;
    // Recover git_hash_from/to from the last validation line (the rich parser
    // drops them; keep the parse here minimal and tolerant).
    let (git_hash_from, git_hash_to) = {
        let line = validation_content
            .lines()
            .rev()
            .find(|l| !l.trim().is_empty())?;
        let val: serde_json::Value = serde_json::from_str(line.trim()).ok()?;
        (
            val["git_hash_from"].as_str().unwrap_or("unknown").to_string(),
            val["git_hash_to"].as_str().unwrap_or("unknown").to_string(),
        )
    };
    // Snapshot being validated: match by git hash (last matching line wins).
    let snapshots = parse_all_snapshots(snapshot_content);
    let predicted = snapshots
        .iter()
        .rev()
        .find(|s| s.git_hash == git_hash_from)
        .map(|s| s.predicted.clone())
        .unwrap_or_default();
    let mut changed = last.hits.clone();
    changed.extend(last.surprises.iter().cloned());
    Some(LastValidationDetail {
        day: last.day,
        git_hash_from,
        git_hash_to,
        predicted,
        changed,
        accuracy_pct: last.accuracy_pct,
    })
}
```

Careful with the `?` in the closure inside `.find(...)?` — `validation_content.lines().rev().find(|l| !l.trim().is_empty())?` returns Option<&str>, fine in a fn returning Option.


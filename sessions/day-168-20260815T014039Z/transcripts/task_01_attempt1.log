/// Returns true if `line` matches `Downloading <something> v<version>`.
fn is_downloading_line(line: &str) -> bool {
    is_versioned_cargo_line(line, "Downloading ")
}

/// Cargo prints crate lines as `Compiling <name> v<semver>` / `Downloading <name> v<semver>`.
/// Match the ` v` separator followed by a version number (digit + a dot), so
/// unrelated output that merely starts with "Compiling "/"Downloading " and
/// contains " v" somewhere isn't collapsed as a cargo build run.
fn is_versioned_cargo_line(line: &str, prefix: &str) -> bool {
    let t = line.trim();
    let Some(rest) = t.strip_prefix(prefix) else {
        return false;
    };
    rest.split(" v")
        .nth(1)
        .is_some_and(|v| {
            let v = v.trim_start();
            v.starts_with(|c: char| c.is_ascii_digit())
                && v[1..].starts_with('.')  // careful with char boundary; better use chars
        })
}
```

Careful with `v[1..]` — v starts with an ASCII digit (1 byte), so v[1..] is a char boundary. Actually `.starts_with(|c: char| ...)` — `str::starts_with` takes a pattern, and closures as patterns work for `char` predicates. Yes, `starts_with` supports `FnMut(char) -> bool` patterns.


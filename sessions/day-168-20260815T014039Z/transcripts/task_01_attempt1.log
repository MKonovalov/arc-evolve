```rust
fn is_versioned_cargo_line(line: &str, prefix: &str) -> bool {
    let t = line.trim();
    let Some(rest) = t.strip_prefix(prefix) else {
        return false;
    };
    rest.split(" v")
        .nth(1)
        .map(|v| {
            let v = v.trim_start();
            let mut chars = v.chars();
            matches!(
                (chars.next(), chars.next()),
                (Some(d), Some('.')) if d.is_ascii_digit()
            )
        })
        .unwrap_or(false)
}
```


```rust
/// Load per-file mutation-survival fractions written by `scripts/run_mutants.sh`.
///
/// The artifact `.arc/mutants_per_file.json` uses the cargo-mutants schema:
/// a top-level object with `tool`, `git_head`, `generated_at`, a `files` array
/// of `{path, mutants, killed, survived}` entries, and a `summary` object.
/// The survival fraction for a file is `survived / (killed + survived)` (in
/// [0,1]); files with no tested mutants get no entry. As a defensive fallback,
/// a flat `{path: fraction}` map is also accepted (the Day 174 task premise).
///
/// Fail-soft: any missing/unparseable/empty file or unexpected shape yields an
/// empty map so risk scoring never blocks on the artifact.
pub(crate) fn load_mutation_survival(
    path: &std::path::Path,
) -> std::collections::HashMap<String, f64> {
    use std::collections::HashMap;

    let content = match std::fs::read_to_string(path) {
        Ok(c) => c,
        Err(_) => return HashMap::new(),
    };
    let trimmed = content.trim();
    if trimmed.is_empty() {
        return HashMap::new();
    }
    let val: serde_json::Value = match serde_json::from_str(trimmed) {
        Ok(v) => v,
        Err(_) => return HashMap::new(),
    };
    let obj = match val.as_object() {
        Some(o) => o,
        None => return HashMap::new(),
    };

    let mut out: HashMap<String, f64> = HashMap::new();

    // Primary schema: a `files` array of {path, mutants, killed, survived}.
    if let Some(files) = obj.get("files").and_then(|v| v.as_array()) {
        for entry in files {
            let Some(entry) = entry.as_object() else {
                continue;
            };
            let Some(file) = entry.get("path").and_then(|v| v.as_str()) else {
                continue;
            };
            let killed = entry.get("killed").and_then(|v| v.as_f64()).unwrap_or(0.0);
            let survived = entry.get("survived").and_then(|v| v.as_f64()).unwrap_or(0.0);
            let tested = killed + survived;
            if tested <= 0.0 {
                continue; // no tested mutants → no signal
            }
            let fraction = (survived / tested).clamp(0.0, 1.0);
            if fraction > 0.0 {
                out.insert(file.to_string(), fraction);
            }
        }
        return out;
    }

    // Defensive fallback: flat {path: fraction} map (old task premise).
    for (file, v) in obj {
        let Some(fraction) = v.as_f64() else {
            continue;
        };
        let fraction = fraction.clamp(0.0, 1.0);
        if fraction > 0.0 {
            out.insert(file.clone(), fraction);
        }
    }
    out
}
```


```rust
pub(crate) fn load_mutation_survival(
    path: &std::path::Path,
) -> std::collections::HashMap<String, f64> {
    use std::collections::HashMap;

    let content = match std::fs::read_to_string(path) {
        Ok(c) => c,
        Err(_) => return HashMap::new(),
    };
    let trimmed = content.trim();
    if trimmed.is_empty() {
        return HashMap::new();
    }
    let val: serde_json::Value = match serde_json::from_str(trimmed) {
        Ok(v) => v,
        Err(_) => return HashMap::new(),
    };
    let obj = match val.as_object() {
        Some(o) => o,
        None => return HashMap::new(),
    };

    let mut out: HashMap<String, f64> = HashMap::new();

    // Real schema (`scripts/run_mutants.sh`): an object with a `files` array
    // of per-file entries {path, mutants, killed, survived}.
    if let Some(files) = obj.get("files").and_then(|v| v.as_array()) {
        for f in files {
            let Some(fobj) = f.as_object() else { continue };
            let Some(path_str) = fobj.get("path").and_then(|v| v.as_str()) else { continue };
            let tested = fobj
                .get("killed")
                .and_then(|v| v.as_f64())
                .unwrap_or(0.0)
                + fobj
                    .get("survived")
                    .and_then(|v| v.as_f64())
                    .unwrap_or(0.0);
            if tested <= 0.0 {
                continue; // no tested mutants → no signal
            }
            let survived = fobj.get("survived").and_then(|v| v.as_f64()).unwrap_or(0.0);
            let fraction = (survived / tested).clamp(0.0, 1.0);
            if fraction > 0.0 {
                out.insert(path_str.to_string(), fraction);
            }
        }
        return out;
    }

    // Legacy/defensive flat map: {file: fraction}
    for (file, v) in obj {
        let Some(fraction) = v.as_f64() else {
            continue;
        };
        let fraction = fraction.clamp(0.0, 1.0);
        if fraction > 0.0 {
            out.insert(file.clone(), fraction);
        }
    }
    out
}
```


```rust
/// Load per-file mutation-survival fractions written by `scripts/run_mutants.sh`
/// into `.arc/mutants_per_file.json`. The artifact's shape is:
///   {"tool": "cargo-mutants", "git_head": ..., "generated_at": ...,
///    "files": [{"path": "...", "mutants": N, "killed": N, "survived": N}],
///    "summary": {...}}
/// and each file's survival fraction is `survived / (killed + survived)`
/// (i.e. the share of tested mutants that escaped). Fail-soft: a missing,
/// unparseable, empty, or differently-shaped file yields an empty map so risk
/// scoring never blocks on the artifact.
pub(crate) fn load_mutation_survival(
    path: &std::path::Path,
) -> std::collections::HashMap<String, f64> {
    use std::collections::HashMap;

    let content = match std::fs::read_to_string(path) {
        Ok(c) => c,
        Err(_) => return HashMap::new(),
    };
    let trimmed = content.trim();
    if trimmed.is_empty() {
        return HashMap::new();
    }
    let val: serde_json::Value = match serde_json::from_str(trimmed) {
        Ok(v) => v,
        Err(_) => return HashMap::new(),
    };

    let mut out: HashMap<String, f64> = HashMap::new();
    // Actual artifact: {"files": [{path, mutants, killed, survived}, ...]}
    if let Some(entries) = val.get("files").and_then(serde_json::Value::as_array) {
        for entry in entries {
            let Some(path) = entry.get("path").and_then(serde_json::Value::as_str) else {
                continue;
            };
            let killed = entry.get("killed").and_then(serde_json::Value::as_f64).unwrap_or(0.0);
            let survived = entry.get("survived").and_then(serde_json::Value::as_f64).unwrap_or(0.0);
            let tested = killed + survived;
            if tested <= 0.0 {
                continue; // no tested mutants → no survival signal
            }
            let fraction = (survived / tested).clamp(0.0, 1.0);
            if fraction > 0.0 {
                out.insert(path.to_string(), fraction);
            }
        }
        return out;
    }

    // Fallback: tolerate a flat {file: fraction} map (older/legacy shape).
    let obj = match val.as_object() {
        Some(o) => o,
        None => return HashMap::new(),
    };
    for (file, v) in obj {
        let Some(fraction) = v.as_f64() else {
            continue;
        };
        let fraction = fraction.clamp(0.0, 1.0);
        if fraction > 0.0 {
            out.insert(file.clone(), fraction);
        }
    }
    out
}
```


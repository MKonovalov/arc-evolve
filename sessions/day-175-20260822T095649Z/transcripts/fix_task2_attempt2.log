```rust
fn format_risk_usage() -> String {
    let mut out = String::new();
    out.push_str(&format!(
        "{BOLD}Usage:{RESET} {CYAN}arc risk <subcommand>{RESET}   (REPL: {CYAN}/risk <subcommand>{RESET})\n\n"
    ));
    out.push_str(&format!("  {BOLD}snapshot{RESET}      Save the current risk ranking for later validation\n"));
    out.push_str(&format!("  {BOLD}validate{RESET}      Check the last snapshot against files that changed since\n"));
    out.push_str(&format!("  {BOLD}history{RESET}       Show past snapshots and validation results\n"));
    out.push_str(&format!("  {BOLD}predict{RESET}       Predict which files are most likely to break next\n"));
    out.push_str(&format!("  {BOLD}accuracy{RESET}      Show prediction accuracy and per-signal breakdown\n"));
    out.push_str(&format!("  {BOLD}effectiveness{RESET} Measure whether the risk reflex is improving over time\n"));
    out.push_str(&format!("  {BOLD}meter{RESET}         Show the snapshot→validate prediction meter progress\n"));
    out.push_str(&format!("  {BOLD}emerging{RESET}      Show anticipatory signals for files accelerating toward fragility\n"));
    out.push_str(&format!("  {BOLD}--all{RESET}         Show all scored files, not just the top 15\n"));
    out.push_str(&format!("  {BOLD}help{RESET}          Show this usage block\n"));
    out
}
```


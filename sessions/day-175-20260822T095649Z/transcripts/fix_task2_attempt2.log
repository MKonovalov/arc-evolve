let risk_tail_help = matches!(args.get(1).map(|s| s.as_str()), Some("risk"))
    && args[2..].iter().any(|a| a == "--help" || a == "-h");
if help_flag && !risk_tail_help {
    print_help();
    return Some(None);
}
```


    s.push_str("  snapshot      Save current predictions for later validation\n");
    s.push_str("  validate      Compare past predictions against actual breakage\n");
    s.push_str("  history       Show snapshot/validation history\n");
    s.push_str("  predict       Structured narrative prediction of risky files\n");
    s.push_str("  accuracy      Prediction accuracy and per-signal breakdown\n");
    s.push_str("  effectiveness Prediction effectiveness from validation events\n");
    s.push_str("  meter         Show the risk meter (snapshot→validate cadence)\n");
    s.push_str("  emerging      Anticipatory signals for files about to become fragile\n");
    s.push_str("\n");
    s.push_str("  --all         (with snapshot/validate) include all scored files\n");
    ...
}

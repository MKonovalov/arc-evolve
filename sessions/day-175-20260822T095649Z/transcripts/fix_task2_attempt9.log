    // default risk report.
    let wants_help = sub.is_empty()
        || sub == "help"
        || sub == "--help"
        || sub == "-h"
        || sub.split_whitespace().any(|tok| tok == "--help" || tok == "-h" || tok == "help");
    if wants_help {
        print!("{}", risk_usage_text());
        return;
    }
    ...
}
```


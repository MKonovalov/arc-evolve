```rust
pub(crate) fn handle_risk(input: &str) {
    let tail = input.strip_prefix("/risk").unwrap_or(input).trim();
    let first = tail.split_whitespace().next().unwrap_or("");

    // Help/usage: bare tail, help, --help, -h — including `snapshot --help`.
    if tail.is_empty() || matches!(first, "help" | "--help" | "-h")
        || tail.split_whitespace().any(|t| t == "--help" || t == "-h" || t == "help")
    {
        print_risk_usage();
        return;
    }

    let sub = first;
    match sub {
        "snapshot" => { handle_risk_snapshot(); return; }
        "history" => { ... }
        "validate" => { ... }
        "predict" => { ... }
        "accuracy" => { ... }
        "effectiveness" => { ... }
        "meter" => { ... }
        "emerging" => { ... }
        _ => {}
    }
    ...
}
```


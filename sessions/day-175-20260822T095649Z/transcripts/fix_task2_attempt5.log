    // Empty tail, explicit help tokens, or a known subcommand followed by
    // a help token (`snapshot --help`, `validate -h`, ...).
    let mut words = sub.split_whitespace();
    match words.next() {
        None => true,
        Some(w) if is_help_token(w) => true,
        Some(_w) => {
            // First word is a subcommand token — if the remainder is a help
            // token, print usage instead of running the subcommand.
            words.next().is_some_and(is_help_token) && words.next().is_none()
        }
    }
}
```


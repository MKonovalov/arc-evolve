/// Concise usage block for the risk subsystem (`/risk help`, `/risk --help`,
/// bare `/risk`). Kept as a pure formatter so tests can pin the output.
fn format_risk_usage() -> String {
    let mut out = String::new();
    out.push_str(&format!("{BOLD}/risk{RESET} — per-file risk scoring based on git history\n\n"));
    out.push_str("Usage:\n");
    out.push_str("  /risk               Show top 15 riskiest files\n");
    out.push_str("  /risk --all         Show all scored files\n");
    out.push_str("  /risk snapshot      Save current predictions for later validation\n");
    out.push_str("  /risk validate      Check the last snapshot against files changed since\n");
    out.push_str("  /risk history       Show past snapshots and validation results\n");
    out.push_str("  /risk predict       Predict which files are most likely to break next\n");
    out.push_str("  /risk accuracy      Show prediction accuracy and per-signal breakdown\n");
    out.push_str("  /risk effectiveness Measure whether the risk reflex improves over time\n");
    out.push_str("  /risk meter         Show the snapshot/validation accumulation meter\n");
    out.push_str("  /risk emerging      Show files accelerating toward fragility\n");
    out.push_str("  /risk help          Show this help\n\n");
    out.push_str("  Snapshot/validate accept --all to include all files.\n");
    out
}
```


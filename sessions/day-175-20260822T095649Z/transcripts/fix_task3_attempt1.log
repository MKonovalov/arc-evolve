/// CLI entry point for `arc context` — works without an API key.
/// Prints the local context sections (project context files, git status,
/// file listing) and, when no usable API key is configured, a single note
/// that agent-backed sections were skipped.
pub fn handle_context_cli(input: &str) {
    // Build a minimal local-only context view without an agent.
    // There is no Agent: agent-backed sections (tokens/files) are skipped.

Now the backfill function:

```rust
/// Backfill: validate EVERY unvalidated risk snapshot (not just the last) by
/// replaying each one's predictions against commits since its git_hash.
///
/// This is the cold-start unblock for the dream's prediction-meter gate: the
/// `.arc/risk_snapshots.jsonl` file accumulates ~85 snapshots, but until now
/// only the most recent was ever replayed, so each session produced at most one
/// new matched pair. Backfilling turns all accumulated unvalidated snapshots
/// into matched pairs in a single pass.
///
/// Dedup invariance: a snapshot-span already recorded as a validated `from`
/// association (per the full association set) is skipped — never double-counted.
/// Each snapshot without a recorded association, non-empty predictions, and
/// non-empty git log since its hash gets a lift-carrying validation event
/// (trigger "replay", `total_scored`/`scored_broke` set). Returns the number of
/// events recorded. Unvalidated snapshots that have no commits since them are
/// skipped (nothing to validate yet — they become valid once new commits land).
fn backfill_replay_validate() -> usize {
    let content = match std::fs::read_to_string(RISK_SNAPSHOT_PATH) {
        Ok(c) if !c.trim().is_empty() => c,
        _ => return 0,
    };
    let snapshots = parse_all_snapshots(&content);
    let validation_path = std::path::Path::new(RISK_VALIDATION_PATH);

    // Full dedup set: every (from,to) span already recorded.
    let recorded_from: std::collections::HashSet<String> =
        load_validation_associations(validation_path)
            .into_iter()
            .map(|(from, _)| from)
            .collect();

    let all_risks = compute_file_risk_scores();
    let all_ranked: Vec<String> = all_risks.iter().map(|r| r.path.clone()).collect();
    let head_hash = crate::git::run_git(&["rev-parse", "--short", "HEAD"])
        .unwrap_or_else(|_| "HEAD".to_string())
        .trim()
        .to_string();

    let mut recorded = 0;
    for snap in &snapshots {
        if snap.predicted.is_empty() {
            continue;
        }
        // Dedup: skip already-validated spans.
        if recorded_from.contains(&snap.git_hash) {
            continue;
        }
        if snap.git_hash == "unknown" {
            continue;
        }
        let log_output = match crate::git::run_git(&[
            "log",
            &format!("{}..HEAD", snap.git_hash),
            "--name-only",
            "--oneline",
        ]) {
            Ok(o) if !o.trim().is_empty() => o,
            _ => continue, // no commits since this snapshot (nothing to validate yet)
        };
        if let Some(v) = replay_validate_one(
            snap,
            &log_output,
            Some(&all_ranked),
            validation_path,
            &head_hash,
        ) {
            if v.recorded {
                recorded += 1;
            }
        }
    }
    recorded
}
```


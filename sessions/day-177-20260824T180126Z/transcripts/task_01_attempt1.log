/// Per-file matched pair counting: a file counts as one matched
/// prediction-outcome pair for a validation event when it was flagged
/// (persistent flagged set up to the event's day) AND the event's
/// changed-files contained it.
fn count_matched_pairs(snapshot_content: &str, validation_content: &str) -> u64 {
    // events with their day + changed file identities (hits ∪ surprises), src only
    struct RawEvent { day: u64, changed: Vec<String> }
    let events: Vec<RawEvent> = parse raw validation lines;
    let mut pairs = 0;
    let mut counted: HashSet<(u64, String)> = HashSet::new(); // dedupe: same file counted once per day? or once total?
    for e in events {
        let flagged = flagged_files_from(snapshot_content, e.day);
        for f in e.changed {
            if flagged.contains(f) && !counted.contains(&(e.day, f)) {
                pairs += 1;
                counted.insert((e.day, f));
            }
        }
    }
    pairs
}
```


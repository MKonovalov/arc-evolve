```rust
/// Parse effort from review input — either `--flag` form or natural
/// positional words (`quick`, `thorough`, `deep`, …).
///
/// Strips an effort token from the input and returns the effort level plus
/// the remaining argument string (file path, range, etc.). Unknown tokens are
/// treated as content — never an error.
pub fn parse_review_effort(input: &str) -> (ReviewEffort, String) {
    let mut effort = ReviewEffort::Normal;
    let mut remaining_parts: Vec<&str> = Vec::new();

    for part in input.split_whitespace() {
        match effort_word(part) {
            Some(e) => effort = e,
            None => remaining_parts.push(part),
        }
    }

    (effort, remaining_parts.join(" "))
}

/// Map a single token to an effort level, if it names one.
///
/// Matches `--quick`/`--thorough` flags, the three labels (`quick`,
/// `normal`, `thorough`) by case-sensitive prefix, and natural synonyms
/// (`fast`/`light` → Quick, `deep`/`full` → Thorough). Any other token is
/// None — content, never an error.
fn effort_word(part: &str) -> Option<ReviewEffort> {
    let bare = part.strip_prefix("--").unwrap_or(part);
    match bare {
        "fast" | "light" => return Some(ReviewEffort::Quick),
        "deep" | "full" => return Some(ReviewEffort::Thorough),
        _ => {}
    }
    // Labels match by case-sensitive prefix: "quick", "qui", "normal", …
    if "quick".starts_with(bare) && !bare.is_empty() {
        Some(ReviewEffort::Quick)
    } else if "normal".starts_with(bare) && !bare.is_empty() {
        Some(ReviewEffort::Normal)
    } else if "thorough".starts_with(bare) && !bare.is_empty() {
        Some(ReviewEffort::Thorough)
    } else {
        None
    }
}
```


Let me design the pair counting more concretely:

```rust
fn count_matched_pairs(snapshots: &[ParsedSnapshot], validations: &[ValidationEvent]) -> u64 {
    let mut pairs = 0u64;
    for e in validations {
        if e.changed_files.is_empty() {
            continue;
        }
        // Flagged set = union of flagged paths from snapshots with day <= event day
        let flagged: std::collections::HashSet<&str> = snapshots
            .iter()
            .filter(|s| s.day <= e.day as u64)
            .flat_map(|s| s.flagged.iter().map(|(p, _)| p.as_str()))
            .collect();
        let matched = e.changed_files.iter().filter(|f| flagged.contains(f.as_str())).count();
        pairs += matched as u64;
    }
    pairs
}
```


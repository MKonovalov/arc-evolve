Let me define the pure pair-count:

```rust
/// For each validation event, compute the set of files flagged in snapshots
/// with day <= event day; count changed files (hits ∪ surprises) that are in
/// that flagged set. Only src files count (flagged set is src-only by
/// construction + defensive filter).
pub(crate) fn count_matched_pairs(
    snapshots: &[ParsedSnapshot],
    validations: &[ValidationEvent],
) -> u64 {
    if snapshots.is_empty() || validations.is_empty() {
        return 0;
    }
    // Build day → flagged set incrementally: sort snapshots by day, add each
    // snapshot's flagged paths as we pass its day.
    let mut pairs = 0u64;
    for event in validations {
        let flagged: std::collections::HashSet<&str> = snapshots
            .iter()
            .filter(|s| s.day <= event.day as u64)
            .flat_map(|s| s.flagged_paths().iter().map(|p| p.as_str()))
            .collect();
        let changed: std::collections::HashSet<&str> = event
            .hits
            .iter()
            .chain(event.surprises.iter())
            .map(|s| s.as_str())
            .collect();
        pairs += changed.iter().filter(|f| flagged.contains(*f)).count() as u64;
    }
    pairs
}
```


```rust
pub(crate) fn flagged_files_for(day: u64) -> Vec<String> {
    let content = std::fs::read_to_string(RISK_SNAPSHOT_PATH).unwrap_or_default();
    flagged_files_from_content(&content, day)
}

pub(crate) fn flagged_files_from_content(content: &str, day: u64) -> Vec<String> {
    // map path -> (score, snapshot_index) ; later snapshots overwrite score
    let mut scored: Vec<(String, f64, usize)> = Vec::new(); // (path, score, snapshot_idx)
    for (idx, line) in content.lines().enumerate() {
        let trimmed = line.trim();
        if trimmed.is_empty() { continue; }
        let val: serde_json::Value = match serde_json::from_str(trimmed) { Ok(v) => v, Err(_) => continue };
        let snap_day = val["day"].as_u64().unwrap_or(0);
        if snap_day > day { continue; }
        // flagged entries
        let entries: Vec<(String, f64)> = if let Some(arr) = val["flagged"].as_array() {
            arr.iter().filter_map(|v| {
                let path = v["path"].as_str()?.to_string();
                let score = v["score"].as_f64().unwrap_or(0.0);
                Some((path, score))
            }).collect()
        } else {
            // fallback to top_10
            val["top_10"].as_array().map(|arr| arr.iter().filter_map(|v| {
                let path = v["path"].as_str()?.to_string();
                let score = v["score"].as_f64().unwrap_or(0.0);
                Some((path, score))
            }).collect()).unwrap_or_default()
        };
        for (path, score) in entries {
            if let Some(slot) = scored.iter_mut().find(|(p, _, _)| *p == path) {
                slot.1 = score;
                slot.2 = idx;
            } else {
                scored.push((path, score, idx));
            }
        }
    }
    // highest score first; ties: later snapshot wins
    scored.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal)
        .then(b.2.cmp(&a.2)));
    scored.into_iter().map(|(p, _, _)| p).collect()
}
```


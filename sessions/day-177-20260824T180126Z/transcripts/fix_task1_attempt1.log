```rust
/// Count matched prediction-outcome pairs from the persistent per-file signal.
/// A pair = a validation event's changed file (hit or surprise) that was flagged
/// in a snapshot at-or-before the event's day.
fn count_matched_pairs(snapshots: &[ParsedSnapshot], validations: &[ValidationEvent]) -> u64 {
    let mut pairs = 0u64;
    for e in validations {
        if e.changed_files.is_empty() { continue; }
        let flagged: HashSet<&str> = snapshots
            .iter()
            .filter(|s| s.day <= e.day as u64)
            .flat_map(|s| s.flagged.iter().map(|p| p.as_str()))
            .collect();
        if e.changed_files.iter().any(|f| flagged.contains(f.as_str())) {
            pairs += 1;
        }
    }
    pairs
}
```


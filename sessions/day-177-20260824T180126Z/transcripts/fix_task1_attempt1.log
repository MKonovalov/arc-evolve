Now `count_matched_pairs`:

```rust
/// Count matched prediction-outcome pairs from the persistent per-file flagged
/// set. A pair = a file that the risk scorer had flagged in some snapshot with
/// `day <= event.day`, AND that appears in the event's changed files (hit or
/// surprise). Non-source churn (CLAUDE.md, DAY_COUNT, commit subjects) is never
/// in the flagged set, so it can never form a pair. Events with no flagged
/// match contribute 0; the count can exceed the event count (one event may
/// match several flagged files).
pub(crate) fn count_matched_pairs(
    snapshots: &[ParsedSnapshot],
    validations: &[ValidationEvent],
) -> u64 {
    if snapshots.is_empty() || validations.is_empty() {
        return 0;
    }
    // Cache per-day flagged sets (events share days): build a map day → set of
    // flagged paths from all snapshots with day <= that day.
    let mut pairs = 0u64;
    let mut cache: std::collections::HashMap<u64, std::collections::HashSet<&str>> =
        std::collections::HashMap::new();
    for event in validations {
        let flagged = cache.entry(event.day as u64).or_insert_with(|| {
            snapshots
                .iter()
                .filter(|s| s.day <= event.day as u64)
                .flat_map(|s| s.flagged.iter().map(|(p, _)| p.as_str()))
                .filter(|p| is_scored_file(p))
                .collect()
        });
        let mut changed: std::collections::HashSet<&str> =
            std::collections::HashSet::new();
        changed.extend(event.hits.iter().map(|s| s.as_str()));
        changed.extend(event.surprises.iter().map(|s| s.as_str()));
        pairs += changed.iter().filter(|f| flagged.contains(*f)).count() as u64;
    }
    pairs
}
```


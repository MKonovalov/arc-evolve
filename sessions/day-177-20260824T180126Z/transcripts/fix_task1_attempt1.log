`flagged_files_from(content, day)`:
```rust
/// Pure union helper: gather every file the risk scorer flagged across all
/// snapshots with `day <= given day`, into an ordered set — highest score
/// first; later snapshots tie-break equal scores. Only `src/` files are
/// retained (the scorer only ranks source files, so noise like `CLAUDE.md`,
/// `DAY_COUNT`, or commit-subject strings can never become flagged).
pub(crate) fn flagged_files_from(content: &str, day: u64) -> Vec<String> {
    let mut best: std::collections::HashMap<String, (f64, usize)> = std::collections::HashMap::new();
    for (idx, snap) in parse_all_snapshots(content).iter().enumerate() {
        if snap.day > day {
            continue;
        }
        for (path, score) in &snap.flagged {
            if !is_scored_path(path) {
                continue;
            }
            match best.get(path) {
                Some((best_score, best_idx)) => {
                    if score > best_score || (score == best_score && idx > *best_idx) {
                        best.insert(path.clone(), (*score, idx));
                    }
                }
                None => {
                    best.insert(path.clone(), (*score, idx));
                }
            }
        }
    }
    let mut files: Vec<(String, f64)> = best.into_iter().map(|(p, (s, _))| (p, s)).collect();
    files.sort_by(|a, b| {
        b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal)
            .then_with(|| a.0.cmp(&b.0))
    });
    files.into_iter().map(|(p, _)| p).collect()
}

pub(crate) fn flagged_files_for(day: u64) -> Vec<String> {
    let content = std::fs::read_to_string(RISK_SNAPSHOT_PATH).unwrap_or_default();
    flagged_files_from(&content, day)
}
```


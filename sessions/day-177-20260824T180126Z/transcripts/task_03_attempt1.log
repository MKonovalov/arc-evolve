```rust
// Compute the scored universe once — the current full risk ranking — so a
// surprise can carry its 1-based rank (mirrors the replay path's `all_ranked`).
let all_ranked: Vec<String> = compute_file_risk_scores()
    .iter()
    .map(|r| r.path.clone())
    .collect();
let rank_of = |f: &str| all_ranked.iter().position(|r| r == f).map(|i| i + 1);

let mut hits: Vec<String> = Vec::new();
let mut surprises: Vec<String> = Vec::new();
for f in &src_files {
    if predicted_set.contains(f.as_str()) {
        hits.push(f.to_string());
    } else {
        // Fold the scored-universe rank into the surprise so the ledger keeps
        // the near-miss-vs-cold-miss distinction (rank 11 vs rank 700+) that
        // the calibration readout needs. Path-only fallback when the file
        // isn't in the scored universe.
        let label = match rank_of(f) {
            Some(r) => format!("{f} (rank {r})"),
            None => f.to_string(),
        };
        surprises.push(label);
    }
}
```


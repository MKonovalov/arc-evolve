            .map(|r| r.path.clone())
            .collect(),
    };

    // Classify: which changed src/ files were predicted (hits) vs not (surprises)
    let predicted_set: std::collections::HashSet<&str> =
        last.predicted.iter().map(|s| s.as_str()).collect();

    let mut hits: Vec<String> = Vec::new();
    let mut surprises: Vec<String> = Vec::new();
    for f in &src_files {
        if predicted_set.contains(f.as_str()) {
            hits.push(f.to_string());
        } else {
            // Fold the scored-universe rank into the surprise label so the
            // validation ledger preserves the near-miss vs cold-miss distinction
            // that the calibration readout needs. Consumers only count surprises
            // (`.len()`), so "path (rank N)" stays backward-compatible; a file
            // outside the scored universe falls back to the bare path.
            let label = match all_ranked.iter().position(|r| r == f.as_str()) {
                Some(i) => format!("{} (rank {})", f, i + 1),
                None => f.to_string(),
            };
            surprises.push(label);
        }
    }
```


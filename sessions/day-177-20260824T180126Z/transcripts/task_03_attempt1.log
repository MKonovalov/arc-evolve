```rust
#[test]
fn test_auto_validate_watch_failure_records_surprise_rank() {
    // A changed src/ file that is NOT in the predicted top-10 produces a
    // surprise whose recorded event includes the file's rank in the scored
    // universe (suffix `(rank #N)`), mirroring the replay path. An
    // out-of-universe file persists as a plain path — no panic either way.
    let dir = tempfile::tempdir().expect("create temp dir");
    let snap_path = dir.path().join("snapshots.jsonl");
    let val_path = dir.path().join("validations.jsonl");

    let snapshot = serde_json::json!({
        "ts": "2025-01-15T12:00:00Z",
        "day": 100,
        "git_hash": "abc1234",
        "top_10": [
            {"path": "src/main.rs", "score": 0.9, "signals": ["churn"]},
        ]
    });
    std::fs::write(&snap_path, serde_json::to_string(&snapshot).unwrap())
        .expect("write snapshot");

    // src/commands_risk_snapshots.rs is a real src file, so it IS in the
    // scored universe and must get a rank suffix. src/foo.rs is fictional
    // (never on disk, no churn) — out of universe, plain path.
    let changed = vec![
        "src/commands_risk_snapshots.rs".to_string(), // surprise, in universe
        "src/foo.rs".to_string(),                     // surprise, out of universe
    ];

    auto_validate_after_failure_to(&changed, &snap_path, &val_path);

    let contents = std::fs::read_to_string(&val_path).expect("read validation file");
    let parsed: serde_json::Value =
        serde_json::from_str(contents.lines().next().unwrap()).expect("valid JSON");
    let surprises = parsed["surprises"].as_array().unwrap();
    assert_eq!(surprises.len(), 2, "should have 2 surprises");

    let in_universe = surprises
        .iter()
        .find(|s| s.as_str().unwrap().starts_with("src/commands_risk_snapshots.rs"));
    assert!(
        in_universe.is_some_and(|s| {
            let s = s.as_str().unwrap();
            let rest = &s["src/commands_risk_snapshots.rs".len()..];
            rest.starts_with(" (rank #") && rest.ends_with(')') && rest.len() > 9
        }),
        "in-universe surprise should carry a (rank #N) suffix, got {:?}",
        surprises
    );
    assert!(
        surprises
            .iter()
            .any(|s| s.as_str() == Some("src/foo.rs")),
        "out-of-universe surprise should persist as a plain path, got {:?}",
        surprises
    );
}
```


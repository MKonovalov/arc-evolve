    #[test]
    fn test_auto_validate_surprise_rank_near_vs_cold_miss() {
        let dir = tempfile::tempdir().expect("create temp dir");
        let snap_path = dir.path().join("snapshots.jsonl");
        let val_path = dir.path().join("validations.jsonl");

        let snapshot = serde_json::json!({
            "ts": "2025-01-15T12:00:00Z",
            "day": 100,
            "git_hash": "abc1234",
            "top_10": [
                {"path": "src/main.rs", "score": 0.9, "signals": ["churn"]},
            ]
        });
        std::fs::write(&snap_path, serde_json::to_string(&snapshot).unwrap())
            .expect("write snapshot");

        // Changed files: one hit, plus a near-miss surprise (rank 5) and a
        // cold-miss surprise (rank 900) in a synthetic scored universe.
        let changed = vec![
            "src/main.rs".to_string(),
            "src/foo.rs".to_string(),
            "src/zzz.rs".to_string(),
        ];
        let mut ranked: Vec<String> = (0..900).map(|i| format!("src/gen_{i}.rs")).collect();
        ranked[4] = "src/foo.rs".to_string();   // 1-based rank 5
        ranked[899] = "src/zzz.rs".to_string(); // 1-based rank 900

        auto_validate_after_failure_to(&changed, &snap_path, &val_path, Some(&ranked));

        let contents = std::fs::read_to_string(&val_path).expect("read validation file");
        let parsed: serde_json::Value =
            serde_json::from_str(contents.lines().next().unwrap()).expect("valid JSON");
        let surprises = parsed["surprises"].as_array().unwrap();
        assert_eq!(surprises.len(), 2, "should have 2 surprises");
        assert!(
            surprises.contains(&serde_json::json!("src/foo.rs (rank 5)")),
            "near-miss surprise should persist its rank: {surprises:?}"
        );
        assert!(
            surprises.contains(&serde_json::json!("src/zzz.rs (rank 900)")),
            "cold-miss surprise should persist its rank: {surprises:?}"
        );
        // Hits are persisted bare (no rank folding on the predicted side).
        assert!(parsed["hits"].as_array().unwrap().contains(&serde_json::json!("src/main.rs")));
    }
```


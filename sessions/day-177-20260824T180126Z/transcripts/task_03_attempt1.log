Actually simplest clean approach:

```rust
let mut hits: Vec<String> = Vec::new();
let mut surprises: Vec<String> = Vec::new();
// Scored-universe ranking, computed lazily only when a surprise first
// appears (most sessions have at least one, but avoid the git+disk cost
// when every change was predicted).
let mut all_ranked: Option<Vec<String>> = None;
for f in &src_files {
    if predicted_set.contains(f.as_str()) {
        hits.push(f.to_string());
    } else {
        let ranked = all_ranked.get_or_insert_with(|| {
            compute_file_risk_scores().iter().map(|r| r.path.clone()).collect()
        });
        let rank = ranked.iter().position(|p| p == f).map(|i| i + 1); // 1-based
        surprises.push(surprise_with_rank(f, rank));
    }
}
```


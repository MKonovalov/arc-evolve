#[test]
fn test_auto_validate_surprise_rank_persisted() {
    let dir = tempfile::tempdir().unwrap();
    let snap_path = dir.path().join("snapshots.jsonl");
    let val_path = dir.path().join("validations.jsonl");
    let snapshot = serde_json::json!({
        "ts": "...", "day": 100, "git_hash": "abc1234",
        "top_10": [{"path": "src/main.rs", "score": 0.9, "signals": ["churn"]}]
    });
    std::fs::write(&snap_path, serde_json::to_string(&snapshot).unwrap()).unwrap();
    let changed = vec![
        "src/main.rs".to_string(),         // hit
        "src/foo.rs".to_string(),          // surprise at rank 5
        "src/zzz.rs".to_string(),          // surprise at rank 900
    ];
    // Synthetic scored universe of 900 files: foo.rs at index 4 (rank 5),
    // zzz.rs at index 899 (rank 900).
    let mut ranked: Vec<String> = (0..900).map(|i| format!("src/gen_{}.rs", i)).collect();
    ranked[4] = "src/foo.rs".to_string();
    ranked[899] = "src/zzz.rs".to_string();
    auto_validate_after_failure_to(&changed, &snap_path, &val_path, Some(&ranked));
    let contents = std::fs::read_to_string(&val_path).unwrap();
    let parsed: serde_json::Value = serde_json::from_str(contents.lines().next().unwrap()).unwrap();
    let surprises = parsed["surprises"].as_array().unwrap();
    assert_eq!(surprises.len(), 2);
    assert!(surprises.contains(&serde_json::json!("src/foo.rs (rank 5)")));
    assert!(surprises.contains(&serde_json::json!("src/zzz.rs (rank 900)")));
}
```


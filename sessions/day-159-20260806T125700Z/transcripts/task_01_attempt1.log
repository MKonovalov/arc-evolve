```rust
/// Truncate a string at a safe UTF-8 byte boundary and append a suffix (e.g. `"…"`),
/// never exceeding `max_bytes` in total. Returns the original string unchanged if it
/// fits within `max_bytes`.
pub fn safe_truncate_with_suffix(s: &str, max_bytes: usize, suffix: &str) -> String {
    if s.len() <= max_bytes {
        return s.to_string();
    }
    // Reserve room for the suffix so the total stays within `max_bytes`.
    let budget = max_bytes.saturating_sub(suffix.len());
    let truncated = safe_truncate(s, budget);
    let out = format!("{truncated}{suffix}");
    // If the suffix alone doesn't fit (max_bytes < suffix.len()), trim the
    // result back down char-boundary-safely rather than exceed the budget.
    safe_truncate(&out, max_bytes).to_string()
}
```


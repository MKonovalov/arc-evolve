    assert!(out.len() <= 7);
    assert!(out.ends_with('…'));
    assert!(out.is_char_boundary(out.len()));
}

#[test]
fn test_safe_truncate_with_suffix_tiny_budget() {
    // max_bytes < suffix.len(): result is trimmed to fit (may be empty).
    let out = safe_truncate_with_suffix("hello world", 1, "…");
    assert!(out.len() <= 1);
    let out0 = safe_truncate_with_suffix("hello world", 0, "…");
    assert!(out0.is_empty());
}

Let me define:
```rust
pub fn safe_truncate_with_suffix(s: &str, max_bytes: usize, suffix: &str) -> String {
    if s.len() <= max_bytes {
        return s.to_string();
    }
    if max_bytes < suffix.len() {
        // Suffix alone doesn't fit; still show it as the truncation marker
        // rather than emit an empty string (callers use it as an indicator).
        return format!("{}{}", safe_truncate(s, max_bytes), suffix);
    }
    let budget = max_bytes - suffix.len();
    format!("{}{}", safe_truncate(s, budget), suffix)
}
```


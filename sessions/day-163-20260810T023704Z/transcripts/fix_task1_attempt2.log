```rust
/// True when the configured model needs the free-model workarounds
/// (tool_choice forced to "required" + streaming disabled).
fn is_free_model(&self) -> bool {
    self.provider == "nousresearch" && self.model == "tencent/hy3:free"
}

/// Apply the free-model workarounds that some OpenAI-compatible free
/// endpoints require (answer in prose under tool_choice:"auto", and
/// reject streaming).
fn apply_free_model_workarounds(&self, mut agent: Agent) -> Agent {
    if self.is_free_model() {
        agent = agent.with_tool_choice(Some("required".to_string()));
        agent = agent.with_stream(Some(false));
    }
    agent
}
```


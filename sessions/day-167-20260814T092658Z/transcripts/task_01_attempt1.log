Implementation:

```rust
fn contains_word(text: &str, word: &str) -> bool {
    if text.is_empty() || word.is_empty() {
        return false;
    }
    let lower = text.to_lowercase();
    let word_lower = word.to_lowercase();
    let mut start = 0;
    while let Some(rel) = lower[start..].find(word_lower.as_str()) {
        let abs = start + rel;
        let before_ok = abs == 0 || !lower.as_bytes()[abs - 1].is_ascii_alphanumeric();
        let after = abs + word_lower.len();
        let after_ok = after >= lower.len() || !lower.as_bytes()[after].is_ascii_alphanumeric();
        if before_ok && after_ok {
            return true;
        }
        start = abs + word_lower.len();
    }
    false
}
```

Note: use `word_lower.len()` consistently (byte length of the lowercased word — for ASCII it's the same; for case-folded Unicode like İ→i̇ the length can differ, so using word_lower.len() is actually more correct).


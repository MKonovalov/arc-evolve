/// Handle `/risk predict --misses` — surface the surprise half of the
/// validation loop: files that broke but were NOT in the top-N predictions.
fn handle_risk_predict_misses() {
    let misses = collect_validation_misses(std::path::Path::new(RISK_VALIDATION_PATH));
    let report = format_misses_report(&misses);
    print!("{report}");
}

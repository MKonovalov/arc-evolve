```rust
pub(crate) fn format_misses_report(misses: &[ValidationMiss]) -> String {
    let mut out = String::new();

    if misses.is_empty() {
        out.push_str(&format!(
            "\n  {BOLD}Risk Prediction Misses{RESET}\n\n  No misses recorded — the surprise half of the validation loop is empty.\n  Run /risk predict --misses again after the next validation.\n"
        ));
        return out;
    }

    out.push_str(&format!("\n  {BOLD}Risk Prediction Misses{RESET}\n"));
    out.push_str(&format!(
        "  {DIM}Surprise files — broke but NOT in the top-N prediction. The calibration signal.{RESET}\n"
    ));

    for m in misses {
        out.push_str(&format!("\n  {BOLD}Day {}{RESET}  {DIM}{}..{}{RESET}  accuracy {:.1}%\n", m.day, short_hash(&m.git_hash_from), short_hash(&m.git_hash_to), m.accuracy_pct));
        // sort: .rs first, then non-source dim
        let mut rs: Vec<&str> = m.surprises.iter().filter(|s| is_rs_source(s)).collect();
        let mut other: Vec<&str> = m.surprises.iter().filter(|s| !is_rs_source(s)).collect();
        rs.sort();
        other.sort();
        if rs.is_empty() {
            out.push_str("  │   (no source-file surprises)\n");
        } else {
            for s in rs {
                out.push_str(&format!("  │   {s}\n"));
            }
        }
        for s in other {
            out.push_str(&format!("  │   {DIM}{s}{RESET}\n"));
        }
    }

    // Summary line: total surprise events + recurring .rs blind spots
    let mut counts: HashMap<&str, usize> = HashMap::new();
    for m in misses {
        for s in m.surprises.iter().filter(|s| is_rs_source(s)) {
            *counts.entry(s.as_str()).or_insert(0) += 1;
        }
    }
    // recurring = seen more than once
    let mut recurring: Vec<(&str, usize)> = counts.into_iter().filter(|(_, c)| *c > 1).collect();
    recurring.sort();
    out.push_str("\n  ");
    out.push_str(&format!(
        "{DIM}{} surprise events; recurring .rs blind spots:{RESET} ",
        misses.len()
    ));
    if recurring.is_empty() { ... "none yet" } else { join with ", " }

    out
}
```


```rust
pub(crate) fn format_misses_report(misses: &[ValidationMiss]) -> String {
    let mut out = String::new();
    out.push_str(&format!("\n  {BOLD}Risk Misses{RESET} — files that broke but were NOT predicted\n\n"));

    if misses.is_empty() {
        out.push_str(&format!(
            "  {DIM}No misses recorded yet — the validation loop hasn't logged a surprise.{RESET}\n"
        ));
        return out;
    }

    for miss in misses {
        // separate .rs surprises from non-source churn
        let (rs_files, churn): (Vec<&String>, Vec<&String>) = miss.surprises.iter().partition(|s| s.ends_with(".rs"));
        out.push_str(&format!(
            "  {BOLD}Day {}{RESET} ({DIM}{}..{}{RESET}) — {:.1}% accuracy\n",
            miss.day, miss.git_hash_from, miss.git_hash_to, miss.accuracy_pct
        ));
        for f in rs_files {
            out.push_str(&format!("    • {f}\n"));
        }
        for f in churn {
            out.push_str(&format!("    • {DIM}{f}{RESET}\n"));
        }
    }

    // Summary
    let all_rs: Vec<&String> = misses.iter().flat_map(|m| m.surprises.iter().filter(|s| s.ends_with(".rs"))).collect();
    let mut counts: HashMap<&String, usize> = HashMap::new();
    for f in &all_rs { *counts.entry(f).or_insert(0) += 1; }
    let recurring: Vec<(&String, usize)> = counts.iter().filter(|(_, c)| **c > 1).collect();
    ...
}
```


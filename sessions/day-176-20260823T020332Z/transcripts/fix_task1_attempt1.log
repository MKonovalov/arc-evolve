/// Render the misses (surprise) report from validation events — the legible
/// version of the "what did the sense organ NOT see" half of the calibration
/// loop. Pure: takes parsed misses, returns text. `.rs` surprises are listed
/// first per event (bright), non-source churn (DAY_COUNT, journals, hash lines,
/// .arc/...) is grouped dim at the end — it was de-noised from accuracy in
/// Day 172 and is noise here too. Closes with a one-line summary: total
/// surprise events + recurring `.rs` blind spots seen more than once.
pub(crate) fn format_misses_report(misses: &[ValidationMiss]) -> String {
    let mut out = String::new();
    out.push_str(&format!("\n  📉 {BOLD}Risk Prediction Misses{RESET} — surprise files the sense organ did NOT predict\n\n"));

    if misses.is_empty() {
        out.push_str(&format!("  {DIM}No misses recorded yet — every validation event so far caught what it predicted.{RESET}\n"));
        return out;
    }

    let mut recurring: std::collections::HashMap<&str, usize> = std::collections::HashMap::new();
    let mut source_count: usize = 0;

    for miss in misses {
        let mut src: Vec<&str> = Vec::new();
        let mut churn: Vec<&str> = Vec::new();
        for s in &miss.surprises {
            if s.starts_with("src/") && s.ends_with(".rs") {
                src.push(s);
                *recurring.entry(s.as_str()).or_insert(0) += 1;
            } else {
                churn.push(s);
            }
        }
        ...
    }
}

```rust
/// A parsed validation event with its surprise files (the "what the sense organ
/// did NOT see" half of the calibration signal).
pub(crate) struct ValidationMiss {
    pub(crate) day: u32,
    pub(crate) git_hash_from: String,
    pub(crate) git_hash_to: String,
    pub(crate) accuracy_pct: f64,
    pub(crate) surprises: Vec<String>,
}

/// Parse validation events from JSONL content, keeping only events with
/// non-empty `surprises` and exposing the raw surprise file paths + hashes.
/// Pure (testable without filesystem) — mirrors `parse_validation_events`.
pub(crate) fn parse_validation_misses(content: &str) -> Vec<ValidationMiss> {
    let mut misses = Vec::new();
    for line in content.lines() {
        let trimmed = line.trim();
        if trimmed.is_empty() { continue; }
        let val: serde_json::Value = match serde_json::from_str(trimmed) { Ok(v) => v, Err(_) => continue };
        let surprises: Vec<String> = val["surprises"].as_array()
            .map(|a| a.iter().filter_map(|v| v.as_str().map(|s| s.to_string())).collect())
            .unwrap_or_default();
        if surprises.is_empty() { continue; }
        let day = val["day"].as_u64().unwrap_or(0) as u32;
        let accuracy_pct = val["accuracy_pct"].as_f64().unwrap_or(0.0);
        misses.push(ValidationMiss {
            day,
            git_hash_from: val["git_hash_from"].as_str().unwrap_or("?").to_string(),
            git_hash_to: val["git_hash_to"].as_str().unwrap_or("?").to_string(),
            accuracy_pct,
            surprises,
        });
    }
    misses
}
```

Then re-export in commands_risk.rs via the `pub(crate) use` — add `parse_validation_misses, ValidationMiss`.

### 2. `src/commands_risk_report.rs` — `collect_validation_misses()` + `format_misses_report()`


/// Read `.arc/risk_validations.jsonl` and return validation events with
/// non-empty surprises — the calibration signal of what the sense organ did
/// NOT predict. Pure data prep; rendering is `format_misses_report`.
pub(crate) fn collect_validation_misses() -> Vec<ValidationMiss> {
    let content = match std::fs::read_to_string(RISK_VALIDATION_PATH) {
        Ok(c) => c,
        Err(_) => return Vec::new(),
    };
    parse_validation_misses(&content)
}
```


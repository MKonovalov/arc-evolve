```rust
/// One validation event's surprise payload: the files the scorer did NOT see.
pub(crate) struct ValidationMiss {
    pub(crate) day: u32,
    pub(crate) git_hash_from: String,
    pub(crate) git_hash_to: String,
    pub(crate) accuracy_pct: f64,
    pub(crate) surprises: Vec<String>,
}

/// Read `.arc/risk_validations.jsonl` and return all validation events with a
/// non-empty `surprises` array — the calibration signal ("what did the sense
/// organ NOT see").
pub(crate) fn collect_validation_misses(path: &std::path::Path) -> Vec<ValidationMiss> {
    let content = match std::fs::read_to_string(path) {
        Ok(c) => c,
        Err(_) => return Vec::new(),
    };
    let mut misses = Vec::new();
    for line in content.lines() {
        let trimmed = line.trim();
        if trimmed.is_empty() {
            continue;
        }
        let val: serde_json::Value = match serde_json::from_str(trimmed) {
            Ok(v) => v,
            Err(_) => continue,
        };
        let surprises: Vec<String> = val["surprises"]
            .as_array()
            .map(|a| {
                a.iter()
                    .filter_map(|s| s.as_str().map(|s| s.to_string()))
                    .collect()
            })
            .unwrap_or_default();
        if surprises.is_empty() {
            continue;
        }
        misses.push(ValidationMiss {
            day: val["day"].as_u64().unwrap_or(0) as u32,
            git_hash_from: val["git_hash_from"].as_str().unwrap_or("?").to_string(),
            git_hash_to: val["git_hash_to"].as_str().unwrap_or("?").to_string(),
            accuracy_pct: val["accuracy_pct"].as_f64().unwrap_or(0.0),
            surprises,
        });
    }
    misses
}
```

Then `format_misses_report`:

```rust
/// Format the misses report: per-event day + accuracy + surprise files,
/// `.rs` source surprises first, non-source churn dim/grouped last (the same
/// de-noising axis that Day 172 applied to accuracy). Ends with a one-line
/// summary: total surprise events + recurring `.rs` blind spots.
pub(crate) fn format_misses_report(misses: &[ValidationMiss]) -> String {
    let mut out = String::new();
    out.push_str(&format!(
        "\n  \u{1f50d} {BOLD}Risk Prediction Misses{RESET} — files that broke without being predicted\n"
    ));

    if misses.is_empty() {
        out.push_str(&format!(
            "  {DIM}No misses recorded — every breakage was predicted.{RESET}\n"
        ));
        return out;
    }

    // Recurring .rs blind spots across events (count >1).
    let mut rs_counts: std::collections::BTreeMap<String, usize> = std::collections::BTreeMap::new();
    let is_rs = |s: &str| s.starts_with("src/") && s.ends_with(".rs");

    for m in misses {
        out.push_str(&format!(
            "\n  {BOLD}Day {}:{RESET} {}..{} — {:.1}% accuracy\n",
            m.day, m.git_hash_from, m.git_hash_to, m.accuracy_pct
        ));
        let mut rs: Vec<&str> = m.surprises.iter().map(|s| s.as_str()).filter(|s| is_rs(s)).collect();
        let mut non_rs: Vec<&str> = m.surprises.iter().map(|s| s.as_str()).filter(|s| !is_rs(s)).collect();
        rs.sort_unstable();
        non_rs.sort_unstable();
        if rs.is_empty() && non_rs.is_empty() {
            continue; // shouldn't happen (non-empty surprises guaranteed) but be safe
        }
        if !rs.is_empty() {
            out.push_str("    misses (source):  ");
            out.push_str(&format!("{YELLOW}{}{RESET}", rs.join(", ")));
            out.push('\n');
            for r in rs { *rs_counts.entry(r.to_string()).or_insert(0) += 1; }
        }
        if !non_rs.is_empty() {
            out.push_str(&format!(
                "    {DIM}churn (non-source): {}{RESET}\n",
                non_rs.join(", ")
            ));
        }
    }

    out.push('\n');
    out.push_str(&format!(
        "  {BOLD}Summary:{RESET} {} surprise event(s)",
        misses.len()
    ));
    let recurring: Vec<(&String, &usize)> = rs_counts.iter().filter(|(_, c)| **c > 1).collect();
    if recurring.is_empty() {
        out.push_str(" — no recurring blind spots yet\n");
    } else {
        let items: Vec<String> = recurring.iter().map(|(p, c)| format!("{p} (x{c})")).collect();
        out.push_str(&format!("; recurring blind spots: {}\n", items.join(", ")));
    }
    out
}
```


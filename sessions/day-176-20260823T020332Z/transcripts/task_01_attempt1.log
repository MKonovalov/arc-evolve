```rust
/// A single validation event's surprise half — files that changed but were NOT
/// predicted by the risk scorer. This is the calibration signal for the sense
/// organ: what it did NOT see.
pub(crate) struct ValidationMiss {
    pub(crate) day: u32,
    pub(crate) git_hash_from: String,
    pub(crate) git_hash_to: String,
    pub(crate) accuracy_pct: f64,
    pub(crate) surprises: Vec<String>,
}

pub(crate) fn collect_validation_misses() -> Vec<ValidationMiss> {
    collect_validation_misses_from(std::path::Path::new(RISK_VALIDATION_PATH))
}

pub(crate) fn collect_validation_misses_from(path: &std::path::Path) -> Vec<ValidationMiss> {
    let content = match std::fs::read_to_string(path) {
        Ok(c) => c,
        Err(_) => return Vec::new(),
    };
    parse_validation_misses(&content)
}

pub(crate) fn parse_validation_misses(content: &str) -> Vec<ValidationMiss> {
    let mut misses = Vec::new();
    for line in content.lines() {
        let trimmed = line.trim();
        if trimmed.is_empty() { continue; }
        let val: serde_json::Value = match serde_json::from_str(trimmed) {
            Ok(v) => v,
            Err(_) => continue,
        };
        let surprises: Vec<String> = val["surprises"].as_array().map(|a| {
            a.iter().filter_map(|s| s.as_str().map(String::from)).collect()
        }).unwrap_or_default();
        if surprises.is_empty() { continue; }
        misses.push(ValidationMiss {
            day: val["day"].as_u64().unwrap_or(0) as u32,
            git_hash_from: val["git_hash_from"].as_str().unwrap_or("?").to_string(),
            git_hash_to: val["git_hash_to"].as_str().unwrap_or("?").to_string(),
            accuracy_pct: val["accuracy_pct"].as_f64().unwrap_or(0.0),
            surprises,
        });
    }
    misses
}
```


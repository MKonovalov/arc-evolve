```rust
/// A single validation event's surprise files (what the scorer missed).
pub(crate) struct ValidationMiss {
    pub(crate) day: u32,
    pub(crate) git_hash_from: String,
    pub(crate) git_hash_to: String,
    pub(crate) accuracy_pct: f64,
    pub(crate) surprises: Vec<String>,
}

/// Collect validation events that had non-empty surprises — the "what did the
/// sense organ NOT see" half of the loop. Pure data prep (reads + parses only).
pub(crate) fn collect_validation_misses(path: &std::path::Path) -> Vec<ValidationMiss> {
    let content = match std::fs::read_to_string(path) {
        Ok(c) => c,
        Err(_) => return Vec::new(),
    };
    collect_validation_misses_from(&content)
}

pub(crate) fn collect_validation_misses_from(content: &str) -> Vec<ValidationMiss> {
    let mut misses = Vec::new();
    for line in content.lines() {
        let trimmed = line.trim();
        if trimmed.is_empty() { continue; }
        let val: serde_json::Value = match serde_json::from_str(trimmed) { Ok(v) => v, Err(_) => continue };
        let day = val["day"].as_u64().unwrap_or(0) as u32;
        let accuracy_pct = val["accuracy_pct"].as_f64().unwrap_or(0.0);
        let git_hash_from = val["git_hash_from"].as_str().unwrap_or("?").to_string();
        let git_hash_to = val["git_hash_to"].as_str().unwrap_or("?").to_string();
        let surprises: Vec<String> = val["surprises"].as_array().map(|a| a.iter().filter_map(|v| v.as_str().map(String::from)).collect()).unwrap_or_default();
        if surprises.is_empty() { continue; }
        misses.push(ValidationMiss { day, git_hash_from, git_hash_to, accuracy_pct, surprises });
    }
    misses
}
```


```rust
/// A single validation event that contained surprises — the "what the sense
/// organ did NOT see" half of the calibration loop.
pub(crate) struct ValidationMiss {
    pub(crate) day: u32,
    /// Commit span the replay covered (snapshot hash .. head hash).
    pub(crate) git_hash_from: String,
    pub(crate) git_hash_to: String,
    pub(crate) accuracy_pct: f64,
    /// Files that broke but were NOT in the predicted top-10.
    pub(crate) surprises: Vec<String>,
}

/// Read `.arc/risk_validations.jsonl` and return every validation event that
/// recorded non-empty surprises — the raw material for the `/risk predict --misses`
/// report. Pure (path-driven) so tests can point it at a temp JSONL.
pub(crate) fn collect_validation_misses(path: &std::path::Path) -> Vec<ValidationMiss> {
    let content = match std::fs::read_to_string(path) {
        Ok(c) => c,
        Err(_) => return Vec::new(),
    };
    parse_validation_misses(&content)
}

/// Parse misses from JSONL content (testable without filesystem).
fn parse_validation_misses(content: &str) -> Vec<ValidationMiss> {
    let mut misses = Vec::new();
    for line in content.lines() {
        let trimmed = line.trim();
        if trimmed.is_empty() {
            continue;
        }
        let val: serde_json::Value = match serde_json::from_str(trimmed) {
            Ok(v) => v,
            Err(_) => continue,
        };
        let surprises: Vec<String> = val["surprises"]
            .as_array()
            .map(|a| a.iter().filter_map(|v| v.as_str().map(String::from)).collect())
            .unwrap_or_default();
        if surprises.is_empty() {
            continue;
        }
        let day = val["day"].as_u64().unwrap_or(0) as u32;
        misses.push(ValidationMiss {
            day,
            git_hash_from: val["git_hash_from"].as_str().unwrap_or("?").to_string(),
            git_hash_to: val["git_hash_to"].as_str().unwrap_or("?").to_string(),
            accuracy_pct: val["accuracy_pct"].as_f64().unwrap_or(0.0),
            surprises,
        });
    }
    misses
}
```

Now `format_misses_report` in commands_risk_report.rs:

```rust
/// Render the `/risk predict --misses` report — the surprise half of the
/// validation loop, made legible. Source (`.rs`) surprises come first per
/// event; non-source churn (DAY_COUNT/journal/hash lines — de-noised from
/// accuracy in Day 172) is grouped last in dim. Ends with a one-line summary:
/// total surprise events + recurring `.rs`-only blind spots.
pub(crate) fn format_misses_report(misses: &[ValidationMiss]) -> String {
    let mut out = String::new();
    out.push_str(&format!("\n  {BOLD}🎯 Risk Misses{RESET} — files that broke but were NOT predicted\n\n"));
    if misses.is_empty() {
        out.push_str(&format!("  {DIM}No misses recorded yet — the sense organ hasn't been surprised.{RESET}\n"));
        out.push('\n');
        return out;
    }

    for m in misses {
        out.push_str(&format!(
            "  {BOLD}Day {}{RESET}  {DIM}{}..{}{RESET}  accuracy {:.1}%\n",
            m.day, m.git_hash_from, m.git_hash_to, m.accuracy_pct
        ));
        let mut src: Vec<&String> = m.surprises.iter().filter(|s| s.ends_with(".rs")).collect();
        let mut non_src: Vec<&String> = m.surprises.iter().filter(|s| !s.ends_with(".rs")).collect();
        src.sort();
        non_src.sort();
        for s in &src {
            out.push_str(&format!("    {YELLOW}{}{RESET}\n", s));
        }
        if !non_src.is_empty() {
            out.push_str(&format!("    {DIM}(non-source churn: {}){RESET}\n", non_src.join(", ")));
        }
        out.push('\n');
    }

    // Recurring blind spots: .rs-only surprises seen in more than one event.
    let mut counts: std::collections::HashMap<&str, u32> = std::collections::HashMap::new();
    for m in misses {
        for s in &m.surprises {
            if s.ends_with(".rs") {
                *counts.entry(s.as_str()).or_insert(0) += 1;
            }
        }
    }
    let mut recurring: Vec<(&str, u32)> = counts.into_iter().filter(|(_, c)| *c > 1).collect();
    recurring.sort();
    let mut summary = format!("  {DIM}{} surprise {} ·", misses.len(), if misses.len() == 1 { "event" } else { "events" });
    if recurring.is_empty() {
        summary.push_str(" no recurring .rs blind spots{RESET}\n");
    } else {
        let list: Vec<String> = recurring.iter().map(|(f, c)| format!("{f} (×{c})")).collect();
        summary.push_str(&format!(" recurring .rs blind spots: {}{RESET}\n", list.join(", ")));
    }
    out.push_str(&summary);
    out.push('\n');
    out
}
```


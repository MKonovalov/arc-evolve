```rust
/// Render the "misses" report — the surprise files across validation events.
pub(crate) fn format_misses_report(misses: &[ValidationMiss]) -> String {
    if misses.is_empty() {
        return format!("  {DIM}No validation misses recorded yet — the sense organ hasn't been surprised.{RESET}\n");
    }
    let mut out = String::new();
    out.push_str(&format!("\n  {BOLD}Validation Misses{RESET} — what the risk scorer did NOT see\n\n"));
    let mut rs_seen: std::collections::HashMap<&str, u32> = std::collections::HashMap::new();

    for m in misses {
        // Split surprises into source (.rs) vs non-source churn
        let mut src: Vec<&String> = m.surprises.iter().filter(|s| s.ends_with(".rs")).collect();
        let mut noise: Vec<&String> = m.surprises.iter().filter(|s| !s.ends_with(".rs")).collect();
        src.sort();
        noise.sort();
        out.push_str(&format!("  Day {} — {:.1}% accuracy ({}{}..{})\n", m.day, m.accuracy_pct, ...git hashes));
        for s in &src {
            out.push_str(&format!("    {YELLOW}{}{RESET}\n", s));
            *rs_seen.entry(s.as_str()).or_insert(0) += 1;
        }
        if !noise.is_empty() {
            out.push_str(&format!("    {DIM}+ {} non-source changed{RESET}\n", noise.len()));
        }
    }
    // Summary
    ...
}
```


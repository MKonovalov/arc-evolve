```rust
pub(crate) fn format_misses_report(misses: &[ValidationMiss]) -> String {
    let mut out = String::new();
    out.push_str(&format!("\n  {BOLD}🔍 Validation Misses (surprised the scorer){RESET}\n"));
    if misses.is_empty() {
        out.push_str("  {DIM}No misses recorded yet — the validation loop has no surprises to show.{RESET}\n");
        return out;
    }
    for m in misses {
        out.push_str(&format!("  Day {} ({}..{}) — {:.1}% accuracy\n", m.day, m.git_hash_from, m.git_hash_to, m.accuracy_pct));
        // Split surprises: .rs files first, non-source (noise) last/dim
        let mut rs: Vec<&String> = m.surprises.iter().filter(|s| s.ends_with(".rs")).collect();
        let mut other: Vec<&String> = m.surprises.iter().filter(|s| !s.ends_with(".rs")).collect();
        rs.sort(); other.sort();
        for f in &rs {
            out.push_str(&format!("    {YELLOW}{f}{RESET}\n"));
        }
        if !other.is_empty() {
            // dim grouped noise
            out.push_str(&format!("    {DIM}(non-source churn: {}){RESET}\n", other.join(", ")));
        }
    }
    // summary: total surprise events + .rs-only surprises seen >1 (recurring blind spots)
    let mut counts: HashMap<String, u32> = HashMap::new();
    for m in misses {
        for s in &m.surprises {
            if s.ends_with(".rs") {
                *counts.entry(s.clone()).or_insert(0) += 1;
            }
        }
    }
    let recurring: Vec<String> = counts.iter().filter(|(_, c)| **c > 1).map(|(f, c)| format!("{f} (×{c})")).collect();
    ...
}

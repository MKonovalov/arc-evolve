fn contains_word(haystack: &str, needle: &str) -> bool {
    if needle.is_empty() {
        return false;
    }
    let hb = haystack.as_bytes();
    let nb = needle.as_bytes();
    if hb.len() < nb.len() {
        return false;
    }
    let mut start = 0;
    while let Some(rel) = find_subslice(&hb[start..], nb) {
        let pos = start + rel;
        let before_ok = pos == 0 || !hb[pos - 1].is_ascii_alphanumeric();
        let after = pos + nb.len();
        let after_ok = after == hb.len() || !hb[after].is_ascii_alphanumeric();
        if before_ok && after_ok {
            return true;
        }
        start = pos + 1;
    }
    false
}
```


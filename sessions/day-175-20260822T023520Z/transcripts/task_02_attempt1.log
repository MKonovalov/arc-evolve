#[test]
fn test_dotenv_precedence_env_wins() {
    std::env::set_var("arc_TEST_DOTENV_ENV", "from-env");
    let dir = tempfile::tempdir().unwrap();
    std::fs::write(dir.path().join(".env"), "arc_TEST_DOTENV_ENV=from-file\n").unwrap();
    let got = api_key_from_env_or_dotenv_at("arc_TEST_DOTENV_ENV", &dir.path().join(".env"));
    std::env::remove_var("arc_TEST_DOTENV_ENV");
    assert_eq!(got.as_deref(), Some("from-env"));
}


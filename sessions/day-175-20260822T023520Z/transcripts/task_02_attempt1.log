/// Resolve a provider env var with dotenv fallback: process environment wins;
/// if unset (or empty), fall back to a `KEY=value` line in the CWD's `.env`.
pub(crate) fn env_or_dotenv(key: &str) -> Option<String> {
    match std::env::var(key) {
        Ok(v) if !v.is_empty() => Some(v),
        _ => dotenv_value_from_cwd(key),
    }
}

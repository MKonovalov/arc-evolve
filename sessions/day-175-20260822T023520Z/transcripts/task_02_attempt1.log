fn strip_quotes(value: &str) -> &str {
    let bytes = value.as_bytes();
    if value.len() >= 2 && bytes[0] == bytes[value.len() - 1]
        && (bytes[0] == b'"' || bytes[0] == b'\'')
        && value.is_char_boundary(1)
        && value.is_char_boundary(value.len() - 1)
    {
        return &value[1..value.len() - 1];
    }
    value
}

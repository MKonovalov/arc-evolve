let value = match (value.strip_prefix('"').and_then(|v| v.strip_suffix('"')), value.strip_prefix('\'').and_then(|v| v.strip_suffix('\''))) {
    (Some(unquoted), _) | (_, Some(unquoted)) => unquoted.to_string(),
    _ => value.to_string(),
};
```


/// Load dotenv map from CWD's `.env` (empty map when absent).
pub(crate) fn dotenv_map_from_cwd() -> HashMap<String, String> {
    match std::env::current_dir() {
        Ok(dir) => load_dotenv(&dir),
        Err(_) => HashMap::new(),
    }
}
```


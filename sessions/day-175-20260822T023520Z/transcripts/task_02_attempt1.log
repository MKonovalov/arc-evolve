Let me write the parser carefully with the byte-safety rule (no slicing mid-char):

```rust
/// Parse dotenv-style `KEY=value` file contents into a key→value map.
///
/// Deliberately minimal (no dependency, no interpolation, no shell
/// expansion) — just enough for API keys:
///
/// - Blank lines and full-line `#` comments are ignored.
/// - An optional `export ` prefix is stripped (e.g. `export OPENAI_API_KEY=...`).
/// - Keys and values are trimmed of surrounding whitespace.
/// - Values wrapped in matching single or double quotes have the quotes stripped.
/// - When a key repeats, the last occurrence wins.
pub fn parse_dotenv(content: &str) -> HashMap<String, String> {
    let mut map = HashMap::new();
    for raw_line in content.lines() {
        let line = raw_line.trim();
        if line.is_empty() || line.starts_with('#') {
            continue;
        }
        let line = line.strip_prefix("export ").unwrap_or(line).trim();
        let Some((key, value)) = line.split_once('=') else { continue; };
        let key = key.trim();
        if key.is_empty() {
            continue;
        }
        let value = value.trim();
        let value = unquote_dotenv_value(value);
        map.insert(key.to_string(), value.to_string());
    }
    map
}

/// Strip a single layer of matching `"` or `'` quotes from a dotenv value.
fn unquote_dotenv_value(value: &str) -> &str {
    let bytes = value.as_bytes();
    let len = bytes.len();
    if len >= 2 {
        let first = bytes[0];
        let last = bytes[len - 1];
        if (first == b'"' && last == b'"') || (first == b'\'' && last == b'\'') {
            // Both ends are ASCII quotes, so `1` and `len-1` are char boundaries.
            return &value[1..len - 1];
        }
    }
    value
}

/// Read `key` from the `.env` file in `dir` (if present), without touching the process env.
pub fn load_dotenv_key_from(dir: &Path, key: &str) -> Option<String> {
    let content = std::fs::read_to_string(dir.join(".env")).ok()?;
    parse_dotenv(&content).get(key).cloned()
}

/// Read `key` from a `.env` file in the current working directory, if present.
///
/// Only the CWD is consulted — no upward walk, no system dirs.
pub fn load_dotenv_key(key: &str) -> Option<String> {
    load_dotenv_key_from(Path::new("."), key)
}

/// Resolve a provider API key with dotenv fallback.
///
/// Precedence: process environment > `.env` in the CWD > `None`.
pub fn resolve_api_key_env(env_var: &str) -> Option<String> {
    std::env::var(env_var)
        .ok()
        .filter(|k| !k.is_empty())
        .or_else(|| load_dotenv_key(env_var))
}
```


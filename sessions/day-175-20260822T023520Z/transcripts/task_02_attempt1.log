Also handle quoted with trailing comment after the quote: `KEY="value" # comment`. My quoted branch requires ends_with quote — `"value" # comment` doesn't end with quote. Let me handle: if starts with quote, find the closing quote:

```rust
fn parse_env_value(raw: &str) -> String {
    let v = raw.trim();
    if v.is_empty() { return String::new(); }
    if let Some(rest) = v.strip_prefix('"') {
        // find closing quote, allowing trailing comment after it
        if let Some(end) = rest.find('"') {
            return rest[..end].to_string();
        }
        return rest.to_string(); // unterminated — take rest
    }
    if let Some(rest) = v.strip_prefix('\'') {
        if let Some(end) = rest.find('\'') {
            return rest[..end].to_string();
        }
        return rest.to_string();
    }
    // unquoted: strip inline comment
    match v.find(" #") {
        Some(i) => v[..i].trim().to_string(),
        None => v.to_string(),
    }
}
```


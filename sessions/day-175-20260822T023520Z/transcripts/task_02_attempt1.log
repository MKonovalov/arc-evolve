/// Read a `KEY=value` assignment for `key` from a `.env` file in the current
/// working directory (if present). Used as a fallback when the process
/// environment doesn't set the variable. Only the CWD is checked — no upward
/// walk, no system dirs. Comments (`#`), blank lines, and an optional `export `
/// prefix are supported; values may be unquoted or wrapped in single/double
/// quotes.
pub(crate) fn dotenv_value_from_cwd(key: &str) -> Option<String> {
    let path = std::env::current_dir().ok()?.join(".env");
    let content = std::fs::read_to_string(path).ok()?;
    dotenv_value(&content, key)
}

/// Parse a dotenv-formatted string and return the value for `key`,
/// or `None` if absent. See [`dotenv_value_from_cwd`] for the syntax.
fn dotenv_value(content: &str, key: &str) -> Option<String> {
    for raw_line in content.lines() {
        let line = raw_line.trim();
        if line.is_empty() || line.starts_with('#') {
            continue;
        }
        let line = line.strip_prefix("export ").unwrap_or(line).trim();
        let (name, value) = line.split_once('=')?;  // hmm, need to continue on malformed lines
        ...
    }
}

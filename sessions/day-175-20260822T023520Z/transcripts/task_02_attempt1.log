/// Load `.env` from the current working directory (no upward walk).
/// Returns the parsed map, or an empty map if the file doesn't exist.
pub(crate) fn load_dotenv_cwd() -> HashMap<String, String> {
    let Ok(content) = std::fs::read_to_string(".env") else {
        return HashMap::new();
    };
    parse_dotenv(&content)

Let me write the parser:

```rust
/// Parse `.env`-style `KEY=value` lines from a string.
///
/// Hand-rolled (~40 lines) to keep the dependency tree minimal — the codebase
/// deliberately avoids a dotenv crate. Supported syntax:
///   - `# comment` lines are ignored (also inline comments are NOT stripped,
///     matching the common dotenv behavior of keeping values verbatim)
///   - optional `export ` prefix
///   - unquoted, single-quoted, and double-quoted values
///   - whitespace around key and value is trimmed
///   - empty lines and lines without `=` are ignored
///   - later keys override earlier ones (standard dotenv precedence)
fn parse_dotenv_content(content: &str) -> HashMap<String, String> {
    let mut out = HashMap::new();
    for raw_line in content.lines() {
        let line = raw_line.trim();
        if line.is_empty() || line.starts_with('#') {
            continue;
        }
        let line = line.strip_prefix("export ").unwrap_or(line).trim();
        if line.is_empty() || line.starts_with('#') {
            continue;
        }
        let Some((key, value)) = line.split_once('=') else {
            continue;
        };
        let key = key.trim();
        if key.is_empty() {
            continue;
        }
        let value = value.trim();
        let unquoted = if value.len() >= 2
            && ((value.starts_with('"') && value.ends_with('"'))
                || (value.starts_with('\'') && value.ends_with('\'')))
        {
            &value[1..value.len() - 1]
        } else {
            value
        };
        out.insert(key.to_string(), unquoted.to_string());
    }
    out
}
```


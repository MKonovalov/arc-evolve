Let me now write the parser. Hand-rolled, ~40 lines:

```rust
/// Read `KEY=value` assignments from a `.env` file in the current working
/// directory, if present. Process-environment values always win over these.
///
/// Supports `#` comments, blank lines, an optional `export ` prefix, and
/// simple unquoted, single-quoted, or double-quoted values. The lookup is
/// CWD-only (no upward walk, no system dirs) and never overrides a variable
/// already set in the process environment — the file is parsed once per
/// call; callers are expected to check `std::env::var` first.
pub fn dotenv_value(key: &str) -> Option<String> {
    let path = std::env::current_dir().ok()?.join(".env");
    let content = std::fs::read_to_string(path).ok()?;
    for line in content.lines() {
        let line = line.trim();
        if line.is_empty() || line.starts_with('#') {
            continue;
        }
        let line = line.strip_prefix("export ").unwrap_or(line);
        let Some((k, v)) = line.split_once('=') else { continue };
        let k = k.trim();
        if k != key {
            continue;
        }
        let v = v.trim();
        // Strip matching quotes
        let v = if (v.starts_with('"') && v.ends_with('"') && v.len() >= 2)
            || (v.starts_with('\'') && v.ends_with('\'') && v.len() >= 2) {
            &v[1..v.len() - 1]
        } else {
            v
        };
        return Some(v.to_string());
    }
    None
}

/// Look up a provider key with dotenv support: process env > `.env` in CWD.
pub fn env_key_or_dotenv(var: &str) -> Option<String> {
    match std::env::var(var) {
        Ok(key) if !key.is_empty() => Some(key),
        _ => dotenv_value(var).filter(|k| !k.is_empty()),
    }
}
```


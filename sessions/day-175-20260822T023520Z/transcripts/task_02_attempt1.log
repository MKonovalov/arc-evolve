```rust
//! Minimal dotenv-style `.env` parsing (no external crate).
//!
//! Reads `KEY=value` lines from a `.env` file in the current working
//! directory. Used as a fallback for provider API keys when the
//! corresponding environment variable is not set.

use std::collections::HashMap;
use std::path::Path;

/// Parse dotenv-style file content into a key->value map.
///
/// Supports:
/// - `KEY=value` lines
/// - comments (`#` or `;` in dotenv convention; task says `#`) — task says ignore comments `#`
/// - whitespace trimming around key and value
/// - optional `export ` prefix
/// - simple unquoted values and quoted values (`"..."` or `'...'`), with
///   surrounding quotes stripped (and no escape processing beyond that)
pub fn parse_dotenv(content: &str) -> HashMap<String, String> {
    let mut map = HashMap::new();
    for line in content.lines() {
        let line = line.trim();
        if line.is_empty() || line.starts_with('#') {
            continue;
        }
        let line = line.strip_prefix("export ").unwrap_or(line).trim_start();
        // hmm, strip_prefix("export ") — but "export " might have different spacing. Use trim.
        let Some((key, value)) = line.split_once('=') else { continue };
        let key = key.trim();
        if key.is_empty() {
            continue;
        }
        let value = value.trim();
        let value = unquote(value);
        map.insert(key.to_string(), value);
    }
    map
}

fn unquote(value: &str) -> String {
    if value.len() >= 2 {
        let bytes = value.as_bytes();
        let first = bytes[0];
        let last = bytes[value.len() - 1];
        if (first == b'"' && last == b'"') || (first == b'\'' && last == b'\'') {
            return value[1..value.len() - 1].to_string();
        }
    }
    value.to_string()
}

/// Load `.env` from the current working directory, if present.
pub fn load_env_file() -> Option<HashMap<String, String>> {
    let path = Path::new(".env");
    if !path.is_file() {
        return None;
    }
    let content = std::fs::read_to_string(path).ok()?;
    Some(parse_dotenv(&content))
}

/// Look up `key` in the process environment first, then `.env` in the CWD.
pub fn env_value(key: &str) -> Option<String> {
    if let Ok(v) = std::env::var(key) {
        if !v.is_empty() {
            return Some(v);
        }
    }
    load_env_file().and_then(|m| m.get(key).map(|v| v.clone())).filter(|v| !v.is_empty())
}
```


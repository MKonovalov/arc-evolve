    v if v.starts_with('"') && v.ends_with('"') && v.len() >= 2 => v[1..v.len()-1].to_string(),
    v if v.starts_with('\'') && v.ends_with('\'') && v.len() >= 2 => v[1..v.len()-1].to_string(),
    v => {
        // strip inline comment (whitespace + #)
        match v.find(" #") {
            Some(i) => v[..i].trim().to_string(),
            None => v.trim().to_string(),
        }
    }
};

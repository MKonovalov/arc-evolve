For precedence: process env > .env > defaults.

```rust
/// Resolve a provider API key env var with dotenv fallback.
///
/// Precedence: process environment > `.env` in the current working directory
/// > nothing (caller falls back to config/defaults). Reads `.env` only from the
/// CWD — no upward walk, no system dirs.
pub fn resolve_api_key_env(name: &str) -> Option<String> {
    if let Ok(key) = std::env::var(name) {
        if !key.is_empty() {
            return Some(key);
        }
    }
    // Only consult .env when the process env var is unset/empty (process env wins).
    load_cwd_dotenv().get(name).map(|k| k.clone()).filter(|k| !k.is_empty())
}
```


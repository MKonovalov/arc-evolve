Now the pure computation function:

```rust
/// Compute the risk meter from snapshot + validation JSONL content.
///
/// Reuses the existing parsers (`parse_all_snapshots`, `parse_validation_events`).
/// `pairs` = lift-carrying validation events (all three lift fields present),
/// the same events the accuracy report counts as matched prediction-outcome pairs.
pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let validations = parse_validation_events(validation_content);
    let pairs = validations
        .iter()
        .filter(|e| {
            e.predicted_count.is_some() && e.total_scored.is_some() && e.scored_broke.is_some()
        })
        .count();
    let last_snapshot_day = snapshots.last().map(|s| s.day).unwrap_or(0);
    RiskMeter {
        snapshots: snapshots.len(),
        validations: validations.len(),
        pairs,
        last_snapshot_day,
        target_pairs: TARGET_PAIRS,
    }
}
```


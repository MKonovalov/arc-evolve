```rust
/// Default path for the risk meter cadence stamp.
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// The dream milestone: ≥5 matched prediction-outcome pairs before the risk
/// lift is judged. Mirrored here so the meter file carries the goal inline.
pub(crate) const TARGET_PAIRS: usize = 5;

/// Snapshot of the risk prediction-meter accumulation state.
///
/// `pairs` follows the same semantics as the accuracy report's
/// `lift_events_used`: each validation event that carries the lift fields
/// (`predicted_count`, `total_scored`, `scored_broke`) is one matched
/// prediction-outcome pair feeding the pooled lift.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    pub(crate) pairs: usize,
    pub(crate) last_snapshot_day: u64,
    pub(crate) target_pairs: usize,
}

impl RiskMeter {
    fn to_json(&self) -> String {
        serde_json::json!({
            "snapshots": self.snapshots,
            "validations": self.validations,
            "pairs": self.pairs,
            "last_snapshot_day": self.last_snapshot_day,
            "target_pairs": self.target_pairs,
        })
        .to_string()
    }
}
```


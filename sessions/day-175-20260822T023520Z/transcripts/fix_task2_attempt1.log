```rust
#[test]
fn test_parse_dotenv_basic() {
    let content = "\
# comment line
FOO=bar
export BAZ=qux
  TRIMMED =  spaced value  
EMPTY=
QUOTED='single quotes'
DQ=\"double quotes\"
no_equals_here
";
    let map = parse_dotenv(content);
    assert_eq!(map.get("FOO").map(String::as_str), Some("bar"));
    assert_eq!(map.get("BAZ").map(String::as_str), Some("qux"));
    assert_eq!(map.get("TRIMMED").map(String::as_str), Some("spaced value"));
    assert_eq!(map.get("EMPTY").map(String::as_str), Some(""));
    assert_eq!(map.get("QUOTED").map(String::as_str), Some("single quotes"));
    assert_eq!(map.get("DQ").map(String::as_str), Some("double quotes"));
    assert!(!map.contains_key("no_equals_here"));
    assert!(!map.contains_key("comment"));
}

#[test]
fn test_parse_dotenv_duplicate_last_wins() {
    let map = parse_dotenv("KEY=first\nKEY=second\n");
    assert_eq!(map.get("KEY").map(String::as_str), Some("second"));
}

#[test]
fn test_parse_dotenv_inline_hash_not_stripped() {
    // Trailing "# comments" are part of the value
    let map = parse_dotenv("KEY=value#notacomment\n");
    assert_eq!(map.get("KEY").map(String::as_str), Some("value#notacomment"));
}

#[test]
#[serial]
fn test_resolve_api_key_env_precedence() {
    // start clean
    std::env::remove_var("arc_TEST_DOTENV_KEY");
    let tmp = tempfile::TempDir::new().unwrap();
    std::fs::write(tmp.path().join(".env"), "arc_TEST_DOTENV_KEY=from-dotenv\n").unwrap();

    // Save and switch CWD
    let orig_cwd = std::env::current_dir().unwrap();
    std::env::set_current_dir(tmp.path()).unwrap();

    // 1. No env var → dotenv value
    assert_eq!(
        resolve_api_key_env("arc_TEST_DOTENV_KEY").as_deref(),
        Some("from-dotenv")
    );

    // 2. Env var set → process env wins
    std::env::set_var("arc_TEST_DOTENV_KEY", "from-env");
    assert_eq!(
        resolve_api_key_env("arc_TEST_DOTENV_KEY").as_deref(),
        Some("from-env")
    );

    // 3. Env var empty string → dotenv value used (empty env treated as unset)
    std::env::set_var("arc_TEST_DOTENV_KEY", "");
    assert_eq!(
        resolve_api_key_env("arc_TEST_DOTENV_KEY").as_deref(),
        Some("from-dotenv")
    );

    // restore
    std::env::remove_var("arc_TEST_DOTENV_KEY");
    std::env::set_current_dir(orig_cwd).unwrap();
}
```


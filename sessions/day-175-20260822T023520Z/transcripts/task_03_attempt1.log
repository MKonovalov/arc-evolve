/// Default path for the risk meter JSON (a run-counted cadence stamp —
/// recomputed from the two JSONL files on every snapshot write).
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// The dream milestone: ≥5 matched prediction-outcome pairs before the lift
/// measurement is treated as confident (mirrors the cold-start threshold in
/// `compute_accuracy_stats` / `format_accuracy_report`).
pub(crate) const RISK_TARGET_PAIRS: usize = 5;

/// The risk meter — a legibility stamp for the prediction-meter accumulation.
#[derive(Debug)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    /// Matched prediction-outcome pairs: validation events that carry the lift
    /// fields (`predicted_count` + `total_scored` + `scored_broke`) and thus
    /// can feed the pooled lift — the same semantics as the accuracy report's
    /// `Pairs: N/5`.
    pub(crate) pairs: usize,
    pub(crate) last_snapshot_day: u32,
    /// The dream milestone target (5 pairs) — visible in the file so readers
    /// see how far accumulation still has to go.
    pub(crate) target_pairs: usize,
}

/// Compute the meter counts from snapshot + validation JSONL content.
/// Reuses `parse_all_snapshots` / `parse_validation_events` — no duplicated
/// parsing.
pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let events = parse_validation_events(validation_content);
    let pairs = events
        .iter()
        .filter(|e| {
            e.predicted_count.is_some() && e.total_scored.is_some() && e.scored_broke.is_some()
        })
        .count();
    let last_snapshot_day = snapshots.last().map(|s| s.day as u32).unwrap_or(0);
    RiskMeter {
        snapshots: snapshots.len(),
        validations: events.len(),
        pairs,
        last_snapshot_day,
        target_pairs: RISK_TARGET_PAIRS,
    }
}

/// Meter → JSON value (fields snake_case, matching the task's example shape).
fn risk_meter_to_json(meter: &RiskMeter) -> serde_json::Value {
    serde_json::json!({
        "snapshots": meter.snapshots,
        "validations": meter.validations,
        "pairs": meter.pairs,
        "last_snapshot_day": meter.last_snapshot_day,
        "target_pairs": meter.target_pairs,
    })
}

/// Write the meter JSON to a given path (creating parent dirs). Testable.
pub(crate) fn write_risk_meter_to(
    path: &std::path::Path,
    meter: &RiskMeter,
) -> Result<(), std::io::Error> {
    if let Some(parent) = path.parent() {
        std::fs::create_dir_all(parent)?;
    }
    let json = serde_json::to_string_pretty(&risk_meter_to_json(meter))
        .map_err(std::io::Error::other)?;
    std::fs::write(path, json)
}

/// Recompute the meter from the real `.arc` JSONL files and write it to
/// `.arc/risk_meter.json`. No-op (returns a computed meter even on write
/// failure, with a dim note) when a JSONL file is missing — the meter simply
/// reports zero counts rather than inventing state.
pub(crate) fn refresh_risk_meter() -> RiskMeter {
    let snapshot_content = std::fs::read_to_string(RISK_SNAPSHOT_PATH)
        .unwrap_or_default();
    let validation_content = std::fs::read_to_string(RISK_VALIDATION_PATH)
        .unwrap_or_default();
    let meter = compute_risk_meter(&snapshot_content, &validation_content);
    if let Err(e) = write_risk_meter_to(std::path::Path::new(RISK_METER_PATH), &meter) {
        eprintln!("  {DIM}(risk meter write skipped: {e}){RESET}");
    }
    meter
}

/// One-line progress note for the harness path: "risk meter: 1/5 pairs (88 snapshots, 2 validations)".
pub(crate) fn format_risk_meter_line(meter: &RiskMeter) -> String {
    format!(
        "risk meter: {}/{} pairs ({} snapshots, {} validations)",
        meter.pairs, meter.target_pairs, meter.snapshots, meter.validations
    )
}

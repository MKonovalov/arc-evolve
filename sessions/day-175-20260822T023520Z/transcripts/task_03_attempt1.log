```rust
/// Default path for the risk meter JSON file (accumulation progress stamp).
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// The dream milestone: ≥5 matched prediction-outcome pairs before the lift
/// measurement is trustworthy (cold-start threshold from commands_risk_accuracy).
pub(crate) const TARGET_PAIRS: usize = 5;

/// Aggregated state of the prediction meter, computed by counting the two
/// JSONL ledgers. Makes accumulation legible: humans/agents reading
/// `.arc/risk_meter.json` see whether the loop is expected to keep firing.
#[derive(Debug, PartialEq, Eq)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    pub(crate) pairs: usize,
    pub(crate) last_snapshot_day: u32,
    pub(crate) target_pairs: usize,
}

/// Compute the meter from raw JSONL content (pure — testable without fs).
/// `pairs` follows the existing lift semantics: a validation event counts as
/// a matched prediction-outcome pair when it carries the lift fields
/// (`predicted_count` + `total_scored` + `scored_broke`), matching
/// `commands_risk_accuracy::compute_accuracy_stats`'s `lift_events_used`.
pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content).len();
    let events = parse_validation_events(validation_content);
    let validations = events.len();
    let pairs = events
        .iter()
        .filter(|e| {
            e.predicted_count.is_some() && e.total_scored.is_some() && e.scored_broke.is_some()
        })
        .count();
    let last_snapshot_day = parse_all_snapshots(snapshot_content)
        .last()
        .map(|s| s.day as u32)
        .unwrap_or(0);
    RiskMeter {
        snapshots,
        validations,
        pairs,
        last_snapshot_day,
        target_pairs: TARGET_PAIRS,
    }
}
```


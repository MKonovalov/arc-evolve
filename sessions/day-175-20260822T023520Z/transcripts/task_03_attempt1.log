```rust
/// Default path for risk meter JSON file.
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// Dream milestone: number of matched prediction-outcome pairs to accumulate
/// before measuring whether the risk scorer's flagged files break more often.
pub(crate) const RISK_METER_TARGET_PAIRS: usize = 5;

/// Computed risk-meter state: accumulated prediction/validation counts.
#[derive(Debug, Clone, PartialEq)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    pub(crate) pairs: usize,
    pub(crate) target_pairs: usize,
    pub(crate) last_snapshot_day: u32,
}

/// Pure computation of the risk meter from JSONL contents — no filesystem.
pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let validations = parse_validation_events(validation_content);
    let pairs = validations.iter().filter(|v| v.hit_count > 0).count();
    let last_snapshot_day = snapshots.last().map(|s| s.day as u32).unwrap_or(0);
    RiskMeter {
        snapshots: snapshots.len(),
        validations: validations.len(),
        pairs,
        target_pairs: RISK_METER_TARGET_PAIRS,
        last_snapshot_day,
    }
}

/// Serialize the meter to the JSON shown in `.arc/risk_meter.json`.
pub(crate) fn risk_meter_json(meter: &RiskMeter) -> String {
    serde_json::json!({
        "snapshots": meter.snapshots,
        "validations": meter.validations,
        "pairs": meter.pairs,
        "target_pairs": meter.target_pairs,
        "last_snapshot_day": meter.last_snapshot_day,
    })
    .to_string()
}

/// Write the risk meter file (overwrite — it's a stamp, not an append-only log).
pub(crate) fn write_risk_meter(meter: &RiskMeter) -> std::io::Result<()> {
    let path = std::path::Path::new(RISK_METER_PATH);
    if let Some(parent) = path.parent() {
        std::fs::create_dir_all(parent)?;
    }
    std::fs::write(path, format!("{}\n", risk_meter_json(meter)))
}

/// One-line progress note, e.g. "risk meter: 1/5 pairs (88 snapshots, 2 validations)".
pub(crate) fn format_risk_meter_note(meter: &RiskMeter) -> String {
    format!(
        "risk meter: {}/{} pairs ({} snapshots, {} validations)",
        meter.pairs, meter.target_pairs, meter.snapshots, meter.validations
    )
}
```


```rust
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";
pub(crate) const RISK_TARGET_PAIRS: usize = 5;

/// Compute the risk meter counts from snapshot + validation JSONL content.
/// Pairs = validation events carrying the lift fields (`predicted_count`,
/// `total_scored`, `scored_broke`) — the "matched prediction-outcome pair"
/// count the dream milestone tracks (same semantics as `lift_events_used` in
/// `compute_accuracy_stats`).
pub(crate) fn compute_risk_meter(
    snapshot_content: &str,
    validation_content: &str,
) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let events = parse_validation_events(validation_content);
    let pairs = events.iter().filter(|e| {
        e.predicted_count.is_some() && e.total_scored.is_some() && e.scored_broke.is_some()
    }).count();
    let last_snapshot_day = snapshots.iter().last().map(|s| s.day as u32).unwrap_or(0);
    RiskMeter {
        snapshots: snapshots.len(),
        validations: events.len(),
        pairs,
        last_snapshot_day,
        target_pairs: RISK_TARGET_PAIRS,
    }
}

pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    pub(crate) pairs: usize,
    pub(crate) last_snapshot_day: u32,
    pub(crate) target_pairs: usize,
}

impl RiskMeter {
    pub(crate) fn to_json(&self) -> String { ... }
}

/// Write the meter to a path (testable).
pub(crate) fn write_risk_meter_to(path: &std::path::Path, meter: &RiskMeter) -> std::io::Result<()> {
    if let Some(parent) = path.parent() {
        std::fs::create_dir_all(parent)?;
    }
    let json = serde_json::to_string_pretty(&meter_to_value(meter)).map_err(std::io::Error::other)?;
    std::fs::write(path, json)
}

/// Refresh the meter from the real JSONL files (the run-counted cadence stamp).
pub(crate) fn refresh_risk_meter() -> Option<RiskMeter> {
    let snapshot_content = std::fs::read_to_string(RISK_SNAPSHOT_PATH).ok()?;
    let validation_content = std::fs::read_to_string(RISK_VALIDATION_PATH).ok()?;
    let meter = compute_risk_meter(&snapshot_content, &validation_content);
    if let Err(e) = write_risk_meter_to(std::path::Path::new(RISK_METER_PATH), &meter) {
        eprintln!("  {DIM}(risk meter write skipped: {e}){RESET}");
        return Some(meter);
    }
    Some(meter)
}

/// Format a one-line progress note: "risk meter: 1/5 pairs (88 snapshots, 2 validations)".
pub(crate) fn format_risk_meter_line(meter: &RiskMeter) -> String {
    format!(
        "risk meter: {}/{} pairs ({} snapshots, {} validations)",
        meter.pairs, meter.target_pairs, meter.snapshots, meter.validations
    )
}
```


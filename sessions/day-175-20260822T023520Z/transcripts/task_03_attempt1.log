/// Write the meter JSON to the given path (overwrite — it's a single-line
/// current-state file, not an append ledger).
pub(crate) fn write_risk_meter_to(path: &std::path::Path) -> std::io::Result<()> {
    let snaps = std::fs::read_to_string(RISK_SNAPSHOT_PATH).unwrap_or_default();
    let validations = std::fs::read_to_string(RISK_VALIDATION_PATH).unwrap_or_default();
    let meter = compute_risk_meter_from(&snaps, &validations);
    let json = serde_json::json!({
        "snapshots": meter.snapshots,
        "validations": meter.validations,
        "pairs": meter.pairs,
        "last_snapshot_day": meter.last_snapshot_day,
        "target_pairs": meter.target_pairs,
    });
    if let Some(parent) = path.parent() {
        std::fs::create_dir_all(parent)?;
    }
    std::fs::write(path, serde_json::to_string_pretty(&json)?)
}
```


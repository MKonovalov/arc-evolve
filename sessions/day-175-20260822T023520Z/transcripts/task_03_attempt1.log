   /// Path for the risk meter state file (`.arc/risk_meter.json`).
   pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

   /// Dream milestone: matched prediction-outcome pairs needed before the
   /// accuracy lift is trusted. Mirrors the cold-start threshold used by
   /// `commands_risk_accuracy`.
   pub(crate) const RISK_TARGET_PAIRS: u64 = 5;

   /// Computed snapshot of the prediction meter.
   pub(crate) struct RiskMeter {
       pub(crate) snapshots: usize,
       pub(crate) validations: usize,
       /// Matched prediction-outcome pairs: validation events carrying the lift
       /// fields (`predicted_count`, `total_scored`, `scored_broke`) — the same
       /// semantics as `lift_events_used` in the accuracy module (the dream's
       /// ≥5-pair cold-start threshold).
       pub(crate) pairs: usize,
       pub(crate) last_snapshot_day: u64,
   }

   /// Compute the meter counts from snapshot + validation JSONL content.
   pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
       let snapshots = parse_all_snapshots(snapshot_content);
       let events = parse_validation_events(validation_content);
       let pairs = events
           .iter()
           .filter(|e| e.predicted_count.is_some() && e.total_scored.is_some() && e.scored_broke.is_some())
           .count();
       let last_snapshot_day = snapshots.last().map(|s| s.day).unwrap_or(0);
       RiskMeter { snapshots: snapshots.len(), validations: events.len(), pairs, last_snapshot_day }
   }

   /// Write the risk meter state to `.arc/risk_meter.json` (path variant for tests).
   pub(crate) fn write_risk_meter_to(path: &Path) -> RiskMeter {
       let snapshot_content = std::fs::read_to_string(RISK_SNAPSHOT_PATH).unwrap_or_default();
       let validation_content = std::fs::read_to_string(RISK_VALIDATION_PATH).unwrap_or_default();
       let meter = compute_risk_meter(&snapshot_content, &validation_content);
       if let Some(parent) = path.parent() { let _ = std::fs::create_dir_all(parent); }
       let json = serde_json::json!({
           "snapshots": meter.snapshots,
           "validations": meter.validations,
           "pairs": meter.pairs,
           "target_pairs": RISK_TARGET_PAIRS,
           "last_snapshot_day": meter.last_snapshot_day,
       });
       if let Ok(s) = serde_json::to_string(&json) {
           let _ = std::fs::write(path, s);
       }
       meter
   }

   pub(crate) fn write_risk_meter() -> RiskMeter {
       write_risk_meter_to(std::path::Path::new(RISK_METER_PATH))
   }

   /// Format the one-line progress note.
   pub(crate) fn format_risk_meter_note(meter: &RiskMeter) -> String {
       format!("risk meter: {}/{} pairs ({} snapshots, {} validations)", meter.pairs, RISK_TARGET_PAIRS, meter.snapshots, meter.validations)
   }

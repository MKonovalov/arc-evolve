```rust
/// Default path for risk meter JSON file.
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// The dream's cold-start accumulation milestone: ≥5 matched
/// prediction-outcome pairs before the lift measurement is trusted.
pub(crate) const TARGET_PAIRS: usize = 5;

/// Snapshot of the prediction meter's accumulation state, computed from the
/// two JSONL ledgers. Makes the cold-start progress legible without a new
/// subcommand and gives `arc risk` a way to report progress toward the
/// ≥5-pair milestone.
#[derive(Debug, Clone, Copy, PartialEq)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    pub(crate) pairs: usize,
    pub(crate) last_snapshot_day: u64,
    pub(crate) target_pairs: usize,
}

/// Compute the meter from snapshot + validation JSONL content.
/// Pairs follow the existing lift semantics from `compute_accuracy_stats`:
/// a matched prediction-outcome pair is a validation event carrying all three
/// lift fields (`predicted_count`, `total_scored`, `scored_broke`).
pub(crate) fn compute_risk_meter_from(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let events = parse_validation_events(validation_content);
    let pairs = events
        .iter()
        .filter(|e| {
            e.predicted_count.is_some() && e.total_scored.is_some() && e.scored_broke.is_some()
        })
        .count();
    RiskMeter {
        snapshots: snapshots.len(),
        validations: events.len(),
        pairs,
        last_snapshot_day: snapshots.last().map(|s| s.day).unwrap_or(0),
        target_pairs: TARGET_PAIRS,
    }
}

/// One-line human-readable progress note.
pub(crate) fn format_risk_meter_line(meter: &RiskMeter) -> String {
    format!(
        "risk meter: {}/{} pairs ({} snapshots, {} validations)",
        meter.pairs, meter.target_pairs, meter.snapshots, meter.validations
    )
}

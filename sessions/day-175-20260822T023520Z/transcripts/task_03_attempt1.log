#[test]
fn test_compute_risk_meter_counts_real_shape() {
    // Fixture shaped like the real ledgers (Day 174): 3 snapshots, 3 validation
    // events, only the two lift-carrying events count as matched pairs.
    let snapshots = concat!(
        "{\"day\":172,\"git_hash\":\"aaa111\",\"top_10\":[{\"path\":\"src/a.rs\",\"score\":0.7,\"signals\":[]}]}\n",
        "{\"day\":173,\"git_hash\":\"bbb222\",\"top_10\":[{\"path\":\"src/b.rs\",\"score\":0.6,\"signals\":[]}]}\n",
        "{\"day\":174,\"git_hash\":\"ccc333\",\"top_10\":[{\"path\":\"src/c.rs\",\"score\":0.5,\"signals\":[]}]}\n",
    );
    let validations = concat!(
        // Lift-carrying event 1.
        "{\"day\":172,\"trigger\":\"replay\",\"hits\":[\"src/a.rs\"],\"surprises\":[],\"predicted_count\":10,\"accuracy_pct\":100.0,\"git_hash_from\":\"aaa\",\"git_hash_to\":\"bbb\",\"total_scored\":77,\"scored_broke\":1}\n",
        // Old-format event WITHOUT lift fields → not a pair.
        "{\"day\":171,\"trigger\":\"watch_failure\",\"hits\":[\"src/x.rs\"],\"surprises\":[],\"predicted_count\":10,\"accuracy_pct\":100.0,\"git_hash_from\":\"zzz\",\"git_hash_to\":\"yyy\"}\n",
        // Lift-carrying event 2 with scored_broke = 0 (still a measured pair).
        "{\"day\":173,\"trigger\":\"cli\",\"hits\":[],\"surprises\":[],\"predicted_count\":5,\"accuracy_pct\":0.0,\"git_hash_from\":\"bbb\",\"git_hash_to\":\"ccc\",\"total_scored\":40,\"scored_broke\":0}\n",
    );
    let meter = compute_risk_meter(snapshots, validations);
    assert_eq!(meter.snapshots, 3);
    assert_eq!(meter.validations, 3);
    assert_eq!(meter.pairs, 2, "only lift-carrying events count as matched pairs");
    assert_eq!(meter.last_snapshot_day, Some(174));
    assert_eq!(meter.target_pairs, TARGET_PAIRS);
}

#[test]
fn test_compute_risk_meter_empty() {
    let meter = compute_risk_meter("", "");
    assert_eq!(meter.snapshots, 0);
    assert_eq!(meter.validations, 0);
    assert_eq!(meter.pairs, 0);
    assert_eq!(meter.last_snapshot_day, None);
}

#[test]
fn test_write_risk_meter_file() {
    let dir = tempfile::tempdir().expect("temp dir");
    let meter_path = dir.path().join("risk_meter.json");
    let snapshot_path = dir.path().join("snapshots.jsonl");
    let validation_path = dir.path().join("validations.jsonl");
    std::fs::write(&snapshot_path, "{\"day\":174,\"git_hash\":\"aaa\",\"top_10\":[{\"path\":\"src/a.rs\",\"score\":0.7,\"signals\":[]}]}\n").unwrap();
    std::fs::write(&validation_path, "{\"day\":172,\"hits\":[\"src/a.rs\"],\"surprises\":[],\"predicted_count\":10,\"accuracy_pct\":100.0,\"git_hash_from\":\"aaa\",\"git_hash_to\":\"bbb\",\"total_scored\":77,\"scored_broke\":1}\n").unwrap();
    let meter = write_risk_meter_to(&meter_path, &snapshot_path, &validation_path);
    let meter = meter.expect("write_risk_meter_to returns meter");
    assert_eq!(meter.pairs, 1);
    let content = std::fs::read_to_string(&meter_path).unwrap();
    let parsed: serde_json::Value = serde_json::from_str(&content).unwrap();
    assert_eq!(parsed["snapshots"], 1);
    assert_eq!(parsed["validations"], 1);
    assert_eq!(parsed["pairs"], 1);
    assert_eq!(parsed["last_snapshot_day"], 174);
    assert_eq!(parsed["target_pairs"], 5);
}

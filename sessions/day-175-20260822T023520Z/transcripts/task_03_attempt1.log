```rust
/// Write the current prediction-meter state to `.arc/risk_meter.json`.
/// Returns the computed meter (for callers that want to surface it).
pub(crate) fn refresh_risk_meter() -> Option<RiskMeter> {
    let snapshot_content = std::fs::read_to_string(RISK_SNAPSHOT_PATH).unwrap_or_default();
    let validation_content = std::fs::read_to_string(RISK_VALIDATION_PATH).unwrap_or_default();
    let meter = compute_risk_meter(&snapshot_content, &validation_content);
    let json = serde_json::json!({
        "snapshots": meter.snapshots,
        "validations": meter.validations,
        "pairs": meter.pairs,
        "last_snapshot_day": meter.last_snapshot_day,
        "target_pairs": meter.target_pairs,
    });
    let path = std::path::Path::new(RISK_METER_PATH);
    if let Some(parent) = path.parent() {
        if std::fs::create_dir_all(parent).is_err() {
            return Some(meter); // file write is best-effort; report the meter anyway
        }
    }
    match std::fs::write(path, serde_json::to_string_pretty(&json).unwrap_or_default()) {
        Ok(_) => Some(meter),
        Err(_) => Some(meter), // best-effort: meter state still reportable
    }
}
```


/// One-line progress note for the harness path (e.g. `arc risk snapshot`).
/// Makes cold-start accumulation visible session-to-session without a new
/// subcommand. Byte-safe (no string slicing).
pub(crate) fn format_risk_meter_line(meter: &RiskMeter) -> String {
    format!(
        "  {DIM}risk meter: {}/{} pairs ({} snapshots, {} validations, last snapshot day {}){RESET}",
        meter.pairs,
        meter.target_pairs,
        meter.snapshots,
        meter.validations,
        meter.last_snapshot_day.map(|d| d.to_string()).unwrap_or_else(|| "—".to_string()),
    )
}
```


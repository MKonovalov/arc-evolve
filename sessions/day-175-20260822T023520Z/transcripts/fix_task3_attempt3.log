```rust
/// Write the current risk meter to `.arc/risk_meter.json` (path variant for tests).
pub(crate) fn write_risk_meter_to(path: &std::path::Path) -> Option<RiskMeter> {
    let snapshot_content = std::fs::read_to_string(RISK_SNAPSHOT_PATH).unwrap_or_default();
    let validation_content = std::fs::read_to_string(RISK_VALIDATION_PATH).unwrap_or_default();
    let meter = compute_risk_meter(&snapshot_content, &validation_content);
    let json = serde_json::json!({
        "snapshots": meter.snapshots,
        "validations": meter.validations,
        "pairs": meter.pairs,
        "target_pairs": meter.target_pairs,
        "last_snapshot_day": meter.last_snapshot_day,
    });
    match serde_json::to_string_pretty(&json)
        .map_err(std::io::Error::other)
        .and_then(|s| {
            if let Some(parent) = path.parent() {
                std::fs::create_dir_all(parent)?;
            }
            std::fs::write(path, s)
        })
    {
        Ok(()) => Some(meter),
        Err(e) => {
            eprintln!("  {DIM}(risk meter write skipped: {e}){RESET}");
            None
        }
    }
}

/// Default-path wrapper for `write_risk_meter_to`.
pub(crate) fn write_risk_meter() -> Option<RiskMeter> {
    write_risk_meter_to(std::path::Path::new(RISK_METER_PATH))
}
```


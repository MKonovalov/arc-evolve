/// Compute the meter from the real ledger files + persist it.
pub(crate) fn refresh_risk_meter() -> Option<RiskMeter> {
    let snapshots = std::fs::read_to_string(RISK_SNAPSHOT_PATH).unwrap_or_default();
    let validations = std::fs::read_to_string(RISK_VALIDATION_PATH).unwrap_or_default();
    let meter = compute_risk_meter(&snapshots, &validations);
    if let Err(e) = write_risk_meter(&meter) {
        eprintln!("  {DIM}(risk meter not written: {e}){RESET}");
    }
    Some(meter)
}
```


   ```rust
   /// Compute the risk meter from raw JSONL content (pure, testable).
   pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
       let snapshots = parse_all_snapshots(snapshot_content);
       let validations = parse_validation_events(validation_content);
       // A "matched prediction-outcome pair" is a validation event that carries
       // the lift fields (predicted_count, total_scored, scored_broke) and so
       // actually feeds the pooled lift — the same semantics as
       // `commands_risk_accuracy::compute_accuracy_stats::lift_events_used`.
       let pairs = validations
           .iter()
           .filter(|e| e.predicted_count.is_some() && e.total_scored.is_some() && e.scored_broke.is_some())
           .count();
       let last_snapshot_day = snapshots.last().map(|s| s.day).unwrap_or(0);
       RiskMeter {
           snapshots: snapshots.len(),
           validations: validations.len(),
           pairs,
           last_snapshot_day,
           target_pairs: TARGET_PAIRS,
       }
   }

   /// Write the meter as JSON to a specific path.
   pub(crate) fn write_risk_meter_to(path: &std::path::Path, meter: &RiskMeter) -> std::io::Result<()> {
       if let Some(parent) = path.parent() {
           std::fs::create_dir_all(parent)?;
       }
       std::fs::write(path, format!("{}\n", meter.to_json()))
   }

   /// Compute + persist the meter from explicit JSONL paths (testable).
   pub(crate) fn refresh_risk_meter_from(
       snapshot_path: &std::path::Path,
       validation_path: &std::path::Path,
       meter_path: &std::path::Path,
   ) -> RiskMeter {
       let snapshot_content = std::fs::read_to_string(snapshot_path).unwrap_or_default();
       let validation_content = std::fs::read_to_string(validation_path).unwrap_or_default();
       let meter = compute_risk_meter(&snapshot_content, &validation_content);
       let _ = write_risk_meter_to(meter_path, &meter);
       meter
   }

   /// The real-path wrapper: compute + persist `.arc/risk_meter.json` from the
   /// real snapshot/validation files. Returns the meter.
   pub(crate) fn refresh_risk_meter() -> RiskMeter {
       refresh_risk_meter_from(
           std::path::Path::new(RISK_SNAPSHOT_PATH),
           std::path::Path::new(RISK_VALIDATION_PATH),
           std::path::Path::new(RISK_METER_PATH),
       )
   }

   /// One-line progress note for the harness path: e.g.
   /// "risk meter: 2/5 pairs (88 snapshots, 2 validations)".
   pub(crate) fn risk_meter_progress_line(meter: &RiskMeter) -> String {
       format!(
           "  {DIM}risk meter: {}/{} pairs ({} snapshots, {} validations){RESET}",
           (meter.pairs as u64).min(meter.target_pairs),
           meter.target_pairs,
           meter.snapshots,
           meter.validations,
       )
   }

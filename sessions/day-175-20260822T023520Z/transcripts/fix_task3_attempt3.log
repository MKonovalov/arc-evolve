```rust
/// Default path for the risk meter JSON file.
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// The dream milestone: ≥5 matched prediction-outcome pairs before judging lift.
pub(crate) const RISK_METER_TARGET_PAIRS: usize = 5;

/// Computed risk-meter state: accumulation totals + progress toward the
/// ≥5-pair dream milestone, derived by counting the two JSONL ledgers.
#[derive(Debug, PartialEq, Clone, Copy)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    pub(crate) pairs: usize,
    pub(crate) last_snapshot_day: u64,
}

impl RiskMeter {
    pub(crate) fn target_pairs(&self) -> usize {
        RISK_METER_TARGET_PAIRS
    }
}
```

Actually, simpler to have a plain struct and compute. Let me write:

```rust
/// Compute the risk meter from snapshot + validation JSONL contents (pure).
///
/// - `snapshots`: number of parsed snapshot entries (via `parse_all_snapshots`).
/// - `validations`: number of parsed validation events (via `parse_validation_events`).
/// - `pairs`: matched prediction-outcome pairs = validation events that carry
///   the lift fields (`predicted_count`, `total_scored`, `scored_broke`), the
///   same semantics `compute_accuracy_stats` uses for `lift_events_used` — the
///   dream's ≥5-pair milestone counts these.
/// - `last_snapshot_day`: day of the most recent snapshot (0 if none).
pub(crate) fn compute_risk_meter(
    snapshot_content: &str,
    validation_content: &str,
) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let events = parse_validation_events(validation_content);
    let pairs = events.iter().filter(|e| {
        e.predicted_count.is_some() && e.total_scored.is_some() && e.scored_broke.is_some()
    }).count();
    let last_snapshot_day = snapshots.last().map(|s| s.day).unwrap_or(0);
    RiskMeter {
        snapshots: snapshots.len(),
        validations: events.len(),
        pairs,
        last_snapshot_day,
    }
}
```

Then the JSON write:

```rust
/// Serialize the meter to its JSON file (`.arc/risk_meter.json`).
pub(crate) fn write_risk_meter(meter: &RiskMeter) -> std::io::Result<()> {
    let path = std::path::Path::new(RISK_METER_PATH);
    if let Some(parent) = path.parent() {
        std::fs::create_dir_all(parent)?;
    }
    let json = serde_json::json!({
        "snapshots": meter.snapshots,
        "validations": meter.validations,
        "pairs": meter.pairs,
        "last_snapshot_day": meter.last_snapshot_day,
        "target_pairs": RISK_METER_TARGET_PAIRS,
    });
    std::fs::write(path, serde_json::to_string_pretty(&json)?)?;
    Ok(())
}
```


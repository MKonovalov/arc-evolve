#[test]
fn test_compute_risk_meter_counts_and_pairs() {
    let snapshots = format!(
        "{}\n{}\n",
        r#"{"ts":"...","day":170,"git_hash":"aaa1111","top_10":[{"path":"src/a.rs","score":0.9,"signals":[]}]}"#,
        r#"{"ts":"...","day":174,"git_hash":"bbb2222","top_10":[{"path":"src/b.rs","score":0.8,"signals":[]}]}"#,
    );
    let validations = format!(
        "{}\n{}\n",
        // no lift fields → not a pair
        r#"{"ts":"...","day":171,"hits":["src/a.rs"],"surprises":[],"predicted_count":10,"accuracy_pct":100.0,"git_hash_from":"aaa1111","git_hash_to":"x"}"#,
        // lift fields + scored_broke ≥ 1 → a pair
        r#"{"ts":"...","day":172,"hits":["src/b.rs"],"surprises":["src/c.rs"],"predicted_count":10,"accuracy_pct":50.0,"git_hash_from":"bbb2222","git_hash_to":"y","total_scored":77,"scored_broke":2}"#,
    );
    let meter = compute_risk_meter(&snapshots, &validations);
    assert_eq!(meter.snapshots, 2);

For the implementation:

```rust
/// Dream-milestone target: number of matched prediction-outcome pairs needed
/// before the risk-lift measurement is considered confident (see DREAM.md).
pub(crate) const RISK_METER_TARGET_PAIRS: usize = 5;

/// Default path for the run-counted cadence stamp JSON file.
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// Aggregate counts for the risk prediction meter, computed from the two
/// existing JSONL ledgers. Written/refreshed on each `arc risk snapshot` run
/// so the accumulation state stays legible session-to-session.
#[derive(Debug, Clone, PartialEq, Eq)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    pub(crate) pairs: usize,
    pub(crate) target_pairs: usize,
    pub(crate) last_snapshot_day: Option<u64>,
}

/// Compute the risk meter from snapshot + validation JSONL content.
/// Pure function (no filesystem) so the cadence-stamp math is unit-testable.
pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let events = parse_validation_events(validation_content);
    let snapshots_count = snapshots.len();
    let validations_count = events.len();
    // A "matched prediction-outcome pair" is a validation event that carries
    // the lift fields (predicted_count/total_scored/scored_broke) with at least
    // one scored file that broke — the same gate `compute_accuracy_stats` uses
    // for `lift_events_used` (DREAM.md's ≥5-pairs milestone).
    let pairs = events
        .iter()
        .filter(|e| {
            e.predicted_count.is_some()
                && e.total_scored.is_some()
                && e.scored_broke.is_some_and(|sb| sb > 0)
        })
        .count();
    let last_snapshot_day = snapshots.last().map(|s| s.day);
    RiskMeter {
        snapshots: snapshots_count,
        validations: validations_count,
        pairs,
        target_pairs: RISK_METER_TARGET_PAIRS,
        last_snapshot_day,
    }
}
```


   /// Default path for the risk meter JSON file.
   pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

   /// The dream milestone threshold for matched prediction-outcome pairs.
   pub(crate) const TARGET_PAIRS: u64 = 5;

   /// A run-counted cadence stamp for the prediction meter: a tiny summary of
   /// how much snapshot/validation accumulation exists, so `arc risk` can
   /// report progress toward the ≥5-pair dream milestone.
   #[derive(Debug, PartialEq, Clone)]
   pub(crate) struct RiskMeter {
       pub(crate) snapshots: usize,
       pub(crate) validations: usize,
       pub(crate) pairs: usize,
       pub(crate) last_snapshot_day: u64,
       pub(crate) target_pairs: u64,
   }

   impl RiskMeter {
       pub(crate) fn to_json(&self) -> String {
           serde_json::json!({
               "snapshots": self.snapshots,
               "validations": self.validations,
               "pairs": self.pairs,
               "last_snapshot_day": self.last_snapshot_day,
               "target_pairs": self.target_pairs,
           })
           .to_string()
       }
   }
   ```


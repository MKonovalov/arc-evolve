```rust
/// Write the meter JSON to the given path (pretty-printed, replacement).
pub(crate) fn write_risk_meter_to(path: &std::path::Path, meter: &RiskMeter) -> std::io::Result<()> {
    if let Some(parent) = path.parent() {
        std::fs::create_dir_all(parent)?;
    }
    let json = serde_json::to_string_pretty(meter).map_err(std::io::Error::other)?;
    std::fs::write(path, format!("{json}\n"))
}
```


/// Default path for the risk meter cadence stamp.
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// The dream's matched-pair milestone: the lift measurement is only trusted
/// once ≥5 prediction-outcome pairs accumulate (see accuracy report).
pub(crate) const TARGET_PAIRS: usize = 5;

/// A run-counted cadence stamp for the risk accumulation state.
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    /// Matched prediction-outcome pairs: validation events that carry the
    /// lift fields (predicted_count + total_scored + scored_broke) — the same
    /// count `compute_accuracy_stats` reports as `lift_events_used` / "Pairs".
    pub(crate) pairs: usize,
    /// Day of the most recently recorded snapshot.
    pub(crate) last_snapshot_day: u32,
    /// Dream milestone this meter accumulates toward.
    pub(crate) target_pairs: usize,
}

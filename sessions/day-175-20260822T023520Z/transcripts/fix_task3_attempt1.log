compute:
```rust
/// Compute the meter from raw JSONL contents (testable without the filesystem).
pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let validations = parse_validation_events(validation_content);
    let pairs = validations
        .iter()
        .filter(|ev| {
            ev.predicted_count.is_some() && ev.total_scored.is_some() && ev.scored_broke.is_some()
        })
        .count();
    RiskMeter {
        snapshots: snapshots.len(),
        validations: validations.len(),
        pairs,
        last_snapshot_day: snapshots.last().map(|s| s.day as u32).unwrap_or(0),
        target_pairs: TARGET_PAIRS,
    }
}
```


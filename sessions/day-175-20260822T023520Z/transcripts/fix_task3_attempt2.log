**Structure for `commands_risk_snapshots.rs`:**

```rust
/// Default path for the risk meter JSON file.
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// The dream's matched-pair milestone: the lift measurement is only
/// trustworthy once ≥5 matched prediction-outcome pairs accumulate.
pub(crate) const TARGET_PAIRS: usize = 5;

/// Aggregated counters for the risk prediction meter — a run-counted
/// cadence stamp that makes accumulation state legible session-to-session.
#[derive(Debug, Clone, PartialEq, Eq)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    pub(crate) pairs: usize,
    pub(crate) last_snapshot_day: u64,
    pub(crate) target_pairs: usize,
}

impl RiskMeter {
    pub(crate) fn progress_line(&self) -> String {
        format!(
            "risk meter: {}/{} pairs ({} snapshots, {} validations)",
            self.pairs, self.target_pairs, self.snapshots, self.validations
        )
    }
}

/// Compute the risk meter from the two existing JSONL archives. Pure —
/// no filesystem access, testable with fixture content.
pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let validations = parse_validation_events(validation_content);
    let snapshots_count = snapshots.len();
    let validations_count = validations.len();
    let last_snapshot_day = snapshots.last().map(|s| s.day).unwrap_or(0);
    // A "matched prediction-outcome pair" is a validation event that (a)
    // recorded a hit — at least one predicted file actually broke — and (b)
    // carries the lift fields (predicted_count/total_scored/scored_broke),
    // matching the pooled-lift semantics in commands_risk_accuracy.
    let pairs = validations
        .iter()
        .filter(|e| {
            e.hit_count > 0
                && e.predicted_count.is_some()
                && e.total_scored.is_some()
                && e.scored_broke.is_some()
        })
        .count();
    RiskMeter {
        snapshots: snapshots_count,
        validations: validations_count,
        pairs,
        last_snapshot_day,
        target_pairs: TARGET_PAIRS,
    }
}

/// Serialize the meter to a JSON string (single object, no trailing newline).
pub(crate) fn risk_meter_json(meter: &RiskMeter) -> String {
    serde_json::to_string(&serde_json::json!({
        "snapshots": meter.snapshots,
        "validations": meter.validations,
        "pairs": meter.pairs,
        "last_snapshot_day": meter.last_snapshot_day,
        "target_pairs": meter.target_pairs,
    }))
    .unwrap_or_else(|_| "{}".to_string())
}

/// Write the meter JSON to the given path (atomically-ish: create parent, write).
pub(crate) fn write_risk_meter_to(path: &std::path::Path, meter: &RiskMeter) -> std::io::Result<()> {
    if let Some(parent) = path.parent() {
        std::fs::create_dir_all(parent)?;
    }
    std::fs::write(path, risk_meter_json(meter).as_bytes())
}
```


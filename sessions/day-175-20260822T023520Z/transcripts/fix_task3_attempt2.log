#[test]
fn test_compute_risk_meter_counts() {
    let snapshots = format!(
        "{}\n{}\n",
        r#"{"ts":"2026-05-01T00:00:00Z","day":5,"git_hash":"aaa","top_10":[{"path":"src/a.rs","score":0.9,"signals":[]}]}"#,
        r#"{"ts":"2026-05-02T00:00:00Z","day":6,"git_hash":"bbb","top_10":[{"path":"src/b.rs","score":0.8,"signals":[]}]}"#,
    );
    // One lifeless event (no total_scored/scored_broke) and one lift-carrying
    // event with hits — only the latter is a matched prediction-outcome pair.
    let validations = format!(
        "{}\n{}\n",
        r#"{"day":5,"trigger":"watch_failure","hits":["src/a.rs"],"surprises":[],"predicted_count":10,"accuracy_pct":100.0}"#,
        r#"{"day":6,"trigger":"replay","hits":["src/b.rs"],"surprises":[],"predicted_count":10,"total_scored":50,"scored_broke":2,"accuracy_pct":100.0}"#,
    );

    let meter = compute_risk_meter(&snapshots, &validations);
    assert_eq!(meter.snapshots, 2);
    assert_eq!(meter.validations, 2);
    assert_eq!(meter.pairs, 1, "only the lift-carrying event with a hit counts as a pair");
    assert_eq!(meter.last_snapshot_day, 6);
    assert_eq!(meter.target_pairs, 5);
    assert_eq!(meter.progress_line(), "risk meter: 1/5 pairs (2 snapshots, 2 validations)");
}
```


```rust
/// Default path for the risk meter JSON file (run-counted cadence stamp).
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// Dream milestone: matched prediction-outcome pairs needed before the lift
/// verdict is trusted. Mirrors the cold-start threshold in
/// `commands_risk_accuracy.rs` (`pairs >= 5`).
pub(crate) const RISK_METER_TARGET_PAIRS: usize = 5;
```

Function:

```rust
#[derive(Debug, Clone, PartialEq, serde::Serialize)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    pub(crate) pairs: usize,
    pub(crate) last_snapshot_day: u64,
    pub(crate) target_pairs: usize,
}

impl RiskMeter {
    pub(crate) fn progress_line(&self) -> String {
        format!(
            "risk meter: {}/{} pairs ({} snapshots, {} validations)",
            self.pairs, self.target_pairs, self.snapshots, self.validations
        )
    }
}

/// Compute the risk meter counts from the two JSONL files' contents.
/// Pure — no filesystem access — so it's unit-testable with fixtures.
pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let events = parse_validation_events(validation_content);

    // A "matched prediction-outcome pair" = a validation event that actually
    // feeds the lift measurement (carries predicted_count + total_scored +
    // scored_broke) AND has at least one hit — a predicted file that broke.
    let pairs = events
        .iter()
        .filter(|e| {
            e.hit_count > 0
                && e.predicted_count.is_some()
                && e.total_scored.is_some()
                && e.scored_broke.is_some()
        })
        .count();

    let last_snapshot_day = snapshots.last().map(|s| s.day).unwrap_or(0);

    RiskMeter {
        snapshots: snapshots.len(),
        validations: events.len(),
        pairs,
        last_snapshot_day,
        target_pairs: RISK_METER_TARGET_PAIRS,
    }
}

/// Read both JSONL files (default paths) and write the meter stamp.
pub(crate) fn refresh_risk_meter() -> std::io::Result<RiskMeter> {
    let snapshot_content = std::fs::read_to_string(RISK_SNAPSHOT_PATH).unwrap_or_default();
    let validation_content = std::fs::read_to_string(RISK_VALIDATION_PATH).unwrap_or_default();
    let meter = compute_risk_meter(&snapshot_content, &validation_content);
    write_risk_meter_to(std::path::Path::new(RISK_METER_PATH), &meter)?;
    Ok(meter)
}

/// Write the meter as pretty JSON to the given path.
pub(crate) fn write_risk_meter_to(path: &std::path::Path, meter: &RiskMeter) -> std::io::Result<()> {
    if let Some(parent) = path.parent() {
        std::fs::create_dir_all(parent)?;
    }
    let json = serde_json::to_string_pretty(meter).map_err(std::io::Error::other)?;
    std::fs::write(path, format!("{json}\n"))
}

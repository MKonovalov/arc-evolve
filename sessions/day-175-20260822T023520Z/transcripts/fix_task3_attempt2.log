/// Target number of matched prediction-outcome pairs for the dream milestone.
pub(crate) const RISK_METER_TARGET_PAIRS: usize = 5;

/// Default path for the risk meter cadence stamp.
pub(crate) const RISK_METER_PATH: &str = ".arc/risk_meter.json";

/// Counts for the risk meter: snapshot/validation counts and the matched-pair
/// count toward the ≥5-pair dream milestone.
#[derive(Debug, PartialEq, Eq)]
pub(crate) struct RiskMeter {
    pub(crate) snapshots: usize,
    pub(crate) validations: usize,
    pub(crate) pairs: usize,
    pub(crate) last_snapshot_day: u64,
    pub(crate) target_pairs: usize,
}

/// Compute the meter from snapshot + validation JSONL content.
/// Pairs = validation events whose hits include at least one scored-broke file
/// — i.e. events that carry the lift measurement (predicted_count,
/// total_scored, scored_broke) AND have ≥1 hit. Re-uses the existing parsers.
pub(crate) fn compute_risk_meter(snapshot_content: &str, validation_content: &str) -> RiskMeter {
    let snapshots = parse_all_snapshots(snapshot_content);
    let events = parse_validation_events(validation_content);
    let pairs = events
        .iter()
        .filter(|e| {
            e.hit_count > 0
                && e.predicted_count.is_some()
                && e.total_scored.is_some()
                && e.scored_broke.is_some()
        })
        .count();
    let last_snapshot_day = snapshots.last().map(|s| s.day).unwrap_or(0);
    RiskMeter {
        snapshots: snapshots.len(),
        validations: events.len(),
        pairs,
        last_snapshot_day,
        target_pairs: RISK_METER_TARGET_PAIRS,
    }
}

/// One-line progress summary for the meter, e.g.
/// "risk meter: 1/5 pairs (88 snapshots, 2 validations)".
pub(crate) fn format_risk_meter(meter: &RiskMeter) -> String {
    format!(
        "risk meter: {}/{} pairs ({} snapshots, {} validations)",
        meter.pairs, meter.target_pairs, meter.snapshots, meter.validations
    )
}

/// Write the meter stamp to `.arc/risk_meter.json` (create parents as needed).
/// Returns the meter on success.
pub(crate) fn write_risk_meter(path: &std::path::Path) -> std::io::Result<RiskMeter> {
    let snapshots = std::fs::read_to_string(RISK_SNAPSHOT_PATH).unwrap_or_default();
    let validations = std::fs::read_to_string(RISK_VALIDATION_PATH).unwrap_or_default();
    let meter = compute_risk_meter(&snapshots, &validations);
    let json = serde_json::json!({
        "snapshots": meter.snapshots,
        "validations": meter.validations,
        "pairs": meter.pairs,
        "last_snapshot_day": meter.last_snapshot_day,
        "target_pairs": meter.target_pairs,
    });
    if let Some(parent) = path.parent() {
        std::fs::create_dir_all(parent)?;
    }
    std::fs::write(path, serde_json::to_string_pretty(&json).map_err(std::io::Error::other)?)?;
    Ok(meter)
}
```


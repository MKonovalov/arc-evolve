#[test]
fn test_risk_meter_writes_file() {
    let dir = tempfile::tempdir().expect("temp dir");
    let snap_path = dir.path().join("snapshots.jsonl");
    let val_path = dir.path().join("validations.jsonl");
    let meter_path = dir.path().join("risk_meter.json");
    std::fs::write(&snap_path, ...)?;
    std::fs::write(&val_path, ...)?;
    let meter = refresh_risk_meter_to(&snap_path, &val_path, &meter_path);
    assert_eq!(meter.snapshots, ...);
    let content = std::fs::read_to_string(&meter_path)?;
    let v: serde_json::Value = serde_json::from_str(&content)?;
    assert_eq!(v["snapshots"], ...);
    assert_eq!(v["target_pairs"], 5);
}
